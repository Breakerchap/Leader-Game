<Window
    x:Class="LeaderGame.Desktop.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Leader Game"
    Width="1440"
    Height="900"
    MinWidth="1050"
    MinHeight="700"
    WindowStartupLocation="CenterScreen">

  <Grid RowDefinitions="64,*">
    <Border
        Grid.Row="0"
        Background="#0F151D"
        BorderBrush="#26313D"
        BorderThickness="0,0,0,1"
        Padding="20,0">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel
            VerticalAlignment="Center"
            Spacing="1">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <TextBlock
                Text="{Binding View.CountryName}"
                FontSize="19"
                FontWeight="SemiBold"
                Foreground="#EDF2F7" />
            <TextBlock
                Text="{Binding View.Date}"
                VerticalAlignment="Center"
                Classes="muted" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="12">
            <TextBlock
                Text="{Binding View.LineageName}"
                FontSize="12"
                Classes="muted" />
            <TextBlock
                Text="{Binding View.StatusMessage}"
                FontSize="12"
                Foreground="#AEBAC8" />
          </StackPanel>
        </StackPanel>

        <StackPanel
            Grid.Column="1"
            Orientation="Horizontal"
            VerticalAlignment="Center"
            Spacing="12">
          <StackPanel
              VerticalAlignment="Center"
              HorizontalAlignment="Right">
            <TextBlock
                Text="{Binding View.RulerName}"
                HorizontalAlignment="Right"
                FontWeight="SemiBold" />
            <TextBlock
                Text="{Binding View.RulerSummary}"
                HorizontalAlignment="Right"
                FontSize="12"
                Classes="muted" />
          </StackPanel>
          <Button
              Classes="primary"
              Command="{Binding AdvanceMonthCommand}"
              Content="Advance month  →" />
        </StackPanel>
      </Grid>
    </Border>

    <Grid
        Grid.Row="1"
        ColumnDefinitions="210,*,300">

      <Border
          Grid.Column="0"
          Background="#0D131A"
          BorderBrush="#26313D"
          BorderThickness="0,0,1,0"
          Padding="14,18">
        <Grid RowDefinitions="Auto,*,Auto">
          <StackPanel Spacing="4">
            <TextBlock
                Text="GOVERNMENT"
                Classes="eyebrow"
                Margin="10,0,0,8" />

            <Button Classes="nav" Content="◆  Briefing" Foreground="#86CBD6"
                    Command="{Binding NavigateCommand}" CommandParameter="Briefing" />
            <Button Classes="nav" Content="▣  Government" Foreground="#B9C5D3"
                    Command="{Binding NavigateCommand}" CommandParameter="Government" />
            <Button Classes="nav" Content="♟  Court" Foreground="#C8ACE1"
                    Command="{Binding NavigateCommand}" CommandParameter="Court" />
            <Button Classes="nav" Content="▥  Economy" Foreground="#92CAA5"
                    Command="{Binding NavigateCommand}" CommandParameter="Economy" />

            <TextBlock
                Text="STATE"
                Classes="eyebrow"
                Margin="10,18,0,8" />
            <Button Classes="nav" Content="◇  Foreign Affairs" Foreground="#8CBCE8"
                    Command="{Binding NavigateCommand}" CommandParameter="Foreign Affairs" />
            <Button Classes="nav" Content="⚑  Military" Foreground="#E99B9B"
                    Command="{Binding NavigateCommand}" CommandParameter="Military" />
            <Button Classes="nav" Content="◉  Intelligence" Foreground="#86CBD6"
                    Command="{Binding NavigateCommand}" CommandParameter="Intelligence" />
            <Button Classes="nav" Content="▤  Archive" Foreground="#AAB5C2"
                    Command="{Binding NavigateCommand}" CommandParameter="Archive" />
          </StackPanel>

          <Border
              Grid.Row="2"
              Classes="card"
              Padding="12"
              Margin="0,16,0,0">
            <StackPanel Spacing="5">
              <TextBlock Text="WORK IN PROGRESS" Classes="eyebrow" />
              <TextBlock
                  Text="Desktop prototype"
                  FontWeight="SemiBold" />
              <TextBlock
                  Text="The console host remains available while desktop surfaces are migrated."
                  FontSize="12"
                  TextWrapping="Wrap"
                  Classes="muted" />
            </StackPanel>
          </Border>
        </Grid>
      </Border>

      <Grid
          Grid.Column="1"
          Margin="24,22"
          ClipToBounds="True">

        <!-- Briefing -->
        <ScrollViewer IsVisible="{Binding IsBriefingVisible}">
          <StackPanel Spacing="20">
            <StackPanel Spacing="7">
              <TextBlock Text="BRIEFING" Classes="eyebrow" Foreground="#70C4D0" />
              <TextBlock
                  Text="What the government thinks it knows"
                  Classes="title" />
              <TextBlock
                  Text="Estimates can be stale, incomplete or wrong. Open Intelligence to inspect their sources."
                  TextWrapping="Wrap"
                  Classes="muted" />
              <WrapPanel Orientation="Horizontal" Margin="0,5,0,0">
                <Border Classes="badge" Background="#14241C" Margin="0,0,7,0">
                  <TextBlock Text="● Economy" Foreground="#75C493" FontSize="11" />
                </Border>
                <Border Classes="badge" Background="#261718" Margin="0,0,7,0">
                  <TextBlock Text="● Military" Foreground="#E28585" FontSize="11" />
                </Border>
                <Border Classes="badge" Background="#211827" Margin="0,0,7,0">
                  <TextBlock Text="● Politics" Foreground="#C096E2" FontSize="11" />
                </Border>
                <Border Classes="badge" Background="#13202B" Margin="0,0,7,0">
                  <TextBlock Text="● Diplomacy / Intel" Foreground="#74B8E8" FontSize="11" />
                </Border>
                <Border Classes="badge" Background="#261F14">
                  <TextBlock Text="▲ Stale / uncertain" Foreground="#D8A657" FontSize="11" />
                </Border>
              </WrapPanel>
            </StackPanel>

            <ItemsControl ItemsSource="{Binding View.Metrics}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border
                      Classes="card"
                      Width="235"
                      MinHeight="122"
                      Margin="0,0,10,10"
                      Padding="0"
                      BorderBrush="{Binding IsStale, Converter={StaticResource StaleBrush}}">
                    <Grid RowDefinitions="5,*">
                      <Border
                          Background="{Binding Label, Converter={StaticResource MetricAccentBrush}}"
                          CornerRadius="8,8,0,0" />
                      <StackPanel Grid.Row="1" Spacing="6" Margin="14,11,14,13">
                        <Grid ColumnDefinitions="*,Auto">
                          <TextBlock Text="{Binding Label}" Classes="eyebrow" />
                          <Border
                              Grid.Column="1"
                              Classes="badge"
                              Background="#2A2115"
                              IsVisible="{Binding IsStale}"
                              Padding="6,2">
                            <TextBlock
                                Text="STALE"
                                FontSize="9"
                                FontWeight="Bold"
                                Foreground="#E1B66F" />
                          </Border>
                        </Grid>
                        <TextBlock
                            Text="{Binding Value}"
                            FontSize="23"
                            FontWeight="SemiBold"
                            Foreground="#F1F5F9" />
                        <TextBlock
                            Text="{Binding Detail}"
                            FontSize="11"
                            TextWrapping="Wrap"
                            Classes="muted" />
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Grid ColumnDefinitions="*,Auto">
              <StackPanel>
                <TextBlock Text="INCOMING" Classes="eyebrow" Foreground="#A9B7C6" />
                <TextBlock
                    Text="Reports, events and decisions"
                    Classes="section" />
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                <Border Classes="badge" Background="#1B2430">
                  <TextBlock
                      Text="{Binding View.PendingOrders, StringFormat='{}{0} orders queued'}"
                      FontSize="11"
                      Foreground="#C4D0DD" />
                </Border>
                <Border Classes="badge" Background="#13252B">
                  <TextBlock
                      Text="{Binding View.PendingReports, StringFormat='{}{0} inquiries underway'}"
                      FontSize="11"
                      Foreground="#86CBD6" />
                </Border>
              </StackPanel>
            </Grid>

            <ItemsControl ItemsSource="{Binding View.Briefings}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border
                      Classes="card"
                      Margin="0,0,0,10"
                      Background="{Binding NeedsAttention, Converter={StaticResource AttentionBackground}}">
                    <Grid ColumnDefinitions="5,*">
                      <Border
                          Background="{Binding Category, Converter={StaticResource CategoryBrush}}"
                          CornerRadius="4"
                          Margin="-5,0,12,0" />
                      <StackPanel Grid.Column="1" Spacing="7">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                          <Border
                              Classes="badge"
                              Background="{Binding Category, Converter={StaticResource CategoryBrush}}"
                              Padding="8,3">
                            <TextBlock
                                Text="{Binding Category}"
                                FontSize="10"
                                FontWeight="Bold"
                                Foreground="#081016" />
                          </Border>
                          <TextBlock
                              Grid.Column="1"
                              Text="{Binding Meta}"
                              FontSize="11"
                              Classes="muted"
                              VerticalAlignment="Center"
                              Margin="9,0,0,0" />
                          <Border
                              Grid.Column="2"
                              Classes="badge"
                              Background="#2B2114"
                              IsVisible="{Binding NeedsAttention}">
                            <TextBlock
                                Text="▲ ATTENTION"
                                FontSize="9"
                                FontWeight="Bold"
                                Foreground="#E3B76C" />
                          </Border>
                        </Grid>
                        <TextBlock
                            Text="{Binding Title}"
                            FontSize="17"
                            FontWeight="SemiBold"
                            TextWrapping="Wrap" />
                        <TextBlock
                            Text="{Binding Summary}"
                            TextWrapping="Wrap"
                            Foreground="#C6D0DB" />
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>

        <!-- Intelligence -->
        <ScrollViewer IsVisible="{Binding IsIntelligenceVisible}">
          <StackPanel Spacing="20">
            <StackPanel Spacing="4">
              <TextBlock Text="INTELLIGENCE" Classes="eyebrow" Foreground="#70C4D0" />
              <TextBlock
                  Text="Reports and inquiries"
                  Classes="title" />
              <TextBlock
                  Text="Task advisers for information, compare their claims and keep track of how old your picture of the world has become."
                  TextWrapping="Wrap"
                  Classes="muted" />
            </StackPanel>

            <Border Classes="card">
              <StackPanel Spacing="12">
                <TextBlock Text="REQUEST A REPORT" Classes="eyebrow" />
                <WrapPanel Orientation="Horizontal">
                  <Button
                      Margin="0,0,8,8"
                      Classes="action economy"
                      Command="{Binding RequestEconomyReportCommand}"
                      Content="▥  Treasurer · Economy" />
                  <Button
                      Margin="0,0,8,8"
                      Classes="action military"
                      Command="{Binding RequestOwnMilitaryReportCommand}"
                      Content="⚑  Marshal · Our military" />
                  <Button
                      Margin="0,0,8,8"
                      Classes="action politics"
                      Command="{Binding RequestDomesticReportCommand}"
                      Content="♟  Chancellor · Domestic politics" />
                </WrapPanel>

                <Grid ColumnDefinitions="220,Auto,Auto" ColumnSpacing="8">
                  <ComboBox
                      ItemsSource="{Binding ForeignCountries}"
                      SelectedItem="{Binding SelectedForeignCountry}"
                      PlaceholderText="Choose foreign country">
                    <ComboBox.ItemTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding Name}" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                  <Button
                      Grid.Column="1"
                      Classes="action intelligence"
                      Command="{Binding RequestForeignAffairsReportCommand}"
                      Content="◇  Chancellor assessment" />
                  <Button
                      Grid.Column="2"
                      Classes="action military"
                      Command="{Binding RequestForeignMilitaryReportCommand}"
                      Content="⚑  Marshal intelligence" />
                </Grid>
              </StackPanel>
            </Border>

            <StackPanel IsVisible="{Binding HasPendingReports}">
              <TextBlock Text="PENDING INQUIRIES" Classes="eyebrow" />
              <ItemsControl ItemsSource="{Binding View.PendingInquiries}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Classes="card" Margin="0,8,0,0" Padding="0">
                      <Grid ColumnDefinitions="5,*,Auto">
                        <Border Background="#55B8C7" CornerRadius="8,0,0,8" />
                        <StackPanel Grid.Column="1" Margin="12" Spacing="3">
                          <StackPanel Orientation="Horizontal" Spacing="7">
                            <TextBlock
                                Text="{Binding Topic}"
                                FontWeight="SemiBold" />
                            <Border Classes="badge" Background="#153038" Padding="7,2">
                              <TextBlock Text="UNDERWAY" FontSize="9" FontWeight="Bold" Foreground="#79CFDB" />
                            </Border>
                          </StackPanel>
                          <TextBlock
                              Text="{Binding Advisor}"
                              FontSize="12"
                              Classes="muted" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" HorizontalAlignment="Right" Margin="12">
                          <TextBlock Text="{Binding Subject}" HorizontalAlignment="Right" />
                          <TextBlock
                              Text="{Binding Since, StringFormat='Queued {0}'}"
                              FontSize="11"
                              Classes="muted"
                              HorizontalAlignment="Right" />
                        </StackPanel>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>

            <StackPanel Spacing="8">
              <TextBlock Text="REPORT HISTORY" Classes="eyebrow" />
              <ItemsControl ItemsSource="{Binding View.IntelligenceReports}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Classes="card" Margin="0,0,0,10">
                      <StackPanel Spacing="8">
                        <Grid ColumnDefinitions="*,Auto">
                          <StackPanel>
                            <TextBlock
                                Text="{Binding Title}"
                                FontSize="17"
                                FontWeight="SemiBold"
                                TextWrapping="Wrap" />
                            <TextBlock
                                Text="{Binding Source}"
                                FontSize="12"
                                Classes="muted" />
                          </StackPanel>
                          <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                            <TextBlock Text="{Binding Origin}" HorizontalAlignment="Right" />
                            <TextBlock
                                Text="{Binding DataAge}"
                                FontSize="11"
                                Classes="muted"
                                HorizontalAlignment="Right" />
                          </StackPanel>
                        </Grid>

                        <TextBlock
                            Text="{Binding Summary}"
                            TextWrapping="Wrap"
                            Foreground="#C4CED9" />

                        <ItemsControl ItemsSource="{Binding Facts}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate>
                              <Grid
                                  ColumnDefinitions="190,110,90,*"
                                  Margin="0,3">
                                <TextBlock Text="{Binding Label}" />
                                <TextBlock
                                    Grid.Column="1"
                                    Text="{Binding Value}"
                                    FontWeight="SemiBold" />
                                <TextBlock
                                    Grid.Column="2"
                                    Text="{Binding Margin}"
                                    Classes="muted" />
                                <TextBlock
                                    Grid.Column="3"
                                    Text="{Binding Confidence}"
                                    FontSize="11"
                                    Classes="muted" />
                              </Grid>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <ItemsControl ItemsSource="{Binding Caveats}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate>
                              <TextBlock
                                  Text="{Binding}"
                                  TextWrapping="Wrap"
                                  Foreground="#C69A61"
                                  FontSize="12"
                                  Margin="0,2" />
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>

        <!-- Placeholder surfaces -->
        <Grid IsVisible="{Binding IsPlaceholderVisible}">
          <Border
              Classes="card"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Top"
              Padding="24">
            <StackPanel Spacing="9">
              <TextBlock
                  Text="{Binding SectionTitle}"
                  Classes="title" />
              <TextBlock
                  Text="{Binding SectionDescription}"
                  FontSize="15"
                  TextWrapping="Wrap"
                  Foreground="#C4CED9"
                  MaxWidth="720" />
              <TextBlock
                  Margin="0,12,0,0"
                  Text="This navigation surface is intentionally present now so each simulation system can migrate behind the same player-information boundary rather than growing as a separate UI."
                  TextWrapping="Wrap"
                  Classes="muted"
                  MaxWidth="720" />
            </StackPanel>
          </Border>
        </Grid>
      </Grid>

      <Border
          Grid.Column="2"
          Background="#0D131A"
          BorderBrush="#26313D"
          BorderThickness="1,0,0,0"
          Padding="18,22">
        <ScrollViewer>
          <StackPanel Spacing="14">
            <StackPanel Spacing="3">
              <TextBlock Text="ADVISERS" Classes="eyebrow" />
              <TextBlock
                  Text="People between you and the state"
                  FontSize="17"
                  FontWeight="SemiBold"
                  TextWrapping="Wrap" />
            </StackPanel>

            <ItemsControl ItemsSource="{Binding View.Advisors}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Classes="card" Margin="0,0,0,10">
                    <StackPanel Spacing="6">
                      <TextBlock
                          Text="{Binding Office}"
                          Classes="eyebrow" />
                      <TextBlock
                          Text="{Binding Name}"
                          FontSize="16"
                          FontWeight="SemiBold" />
                      <Grid
                          ColumnDefinitions="Auto,*"
                          RowDefinitions="Auto,Auto,Auto,Auto"
                          ColumnSpacing="12"
                          RowSpacing="5">
                        <TextBlock Text="Ability" Classes="muted" />
                        <TextBlock
                            Grid.Column="1"
                            Text="{Binding Ability}"
                            FontWeight="SemiBold"
                            Foreground="{Binding Ability, Converter={StaticResource SemanticStatusBrush}}" />

                        <TextBlock Grid.Row="1" Text="Trust" Classes="muted" />
                        <TextBlock
                            Grid.Row="1"
                            Grid.Column="1"
                            Text="{Binding Trust}"
                            FontWeight="SemiBold"
                            Foreground="{Binding Trust, Converter={StaticResource SemanticStatusBrush}}" />

                        <TextBlock Grid.Row="2" Text="Obedience" Classes="muted" />
                        <TextBlock
                            Grid.Row="2"
                            Grid.Column="1"
                            Text="{Binding Obedience}"
                            FontWeight="SemiBold"
                            Foreground="{Binding Obedience, Converter={StaticResource SemanticStatusBrush}}" />

                        <TextBlock Grid.Row="3" Text="Risk" Classes="muted" />
                        <Border
                            Grid.Row="3"
                            Grid.Column="1"
                            Classes="badge"
                            HorizontalAlignment="Left"
                            Background="#171E27"
                            Padding="7,2">
                          <TextBlock
                              Text="{Binding Risk}"
                              FontWeight="Bold"
                              FontSize="11"
                              Foreground="{Binding Risk, Converter={StaticResource RiskBrush}}" />
                        </Border>
                      </Grid>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border Classes="card">
              <StackPanel Spacing="5">
                <TextBlock Text="INFORMATION RULE" Classes="eyebrow" />
                <TextBlock
                    Text="The desktop UI does not bind to hidden simulation values."
                    TextWrapping="Wrap"
                    FontWeight="SemiBold" />
                <TextBlock
                    Text="Numbers shown as estimates come from the ruler's current knowledge state. Advisers may be wrong."
                    TextWrapping="Wrap"
                    FontSize="12"
                    Classes="muted" />
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>
  </Grid>
</Window>

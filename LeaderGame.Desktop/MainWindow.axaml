<Window
    x:Class="LeaderGame.Desktop.MainWindow"
    x:Name="Root"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Leader Game"
    Width="1440"
    Height="900"
    MinWidth="1050"
    MinHeight="700"
    WindowStartupLocation="CenterScreen">

  <Grid RowDefinitions="64,*">
    <Border
        Grid.Row="0"
        IsVisible="{Binding IsCampaignUiVisible}"
        Background="#0F151D"
        BorderBrush="#26313D"
        BorderThickness="0,0,0,1"
        Padding="20,0">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel
            VerticalAlignment="Center"
            Spacing="1">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <TextBlock
                Text="{Binding View.CountryName}"
                FontSize="19"
                FontWeight="SemiBold"
                Foreground="#EDF2F7" />
            <TextBlock
                Text="{Binding View.Date}"
                VerticalAlignment="Center"
                Classes="muted" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="12">
            <TextBlock
                Text="{Binding View.LineageName}"
                FontSize="12"
                Classes="muted" />
            <TextBlock
                Text="{Binding View.StatusMessage}"
                FontSize="12"
                Foreground="#AEBAC8" />
          </StackPanel>
        </StackPanel>

        <StackPanel
            Grid.Column="1"
            Orientation="Horizontal"
            VerticalAlignment="Center"
            Spacing="9">
          <Button
              Classes="action"
              Command="{Binding SaveCommand}"
              Content="▣  Save"
              ToolTip.Tip="{Binding SaveLocation}" />
          <Button
              Classes="action"
              Command="{Binding LoadCommand}"
              Content="↺  Load"
              ToolTip.Tip="{Binding SaveLocation}" />
          <Button
              Classes="action"
              Command="{Binding RecoverAutosaveCommand}"
              Content="⟲  Auto"
              ToolTip.Tip="{Binding AutosaveLocation}" />

          <Border
              Width="1"
              Height="32"
              Background="#2A3643"
              Margin="3,0" />

          <StackPanel
              VerticalAlignment="Center"
              HorizontalAlignment="Right"
              Margin="3,0">
            <TextBlock
                Text="{Binding View.RulerName}"
                HorizontalAlignment="Right"
                FontWeight="SemiBold" />
            <TextBlock
                Text="{Binding View.RulerSummary}"
                HorizontalAlignment="Right"
                FontSize="12"
                Classes="muted" />
          </StackPanel>
          <Button
              Classes="primary"
              Command="{Binding AdvanceMonthCommand}"
              Content="Advance month  →" />
        </StackPanel>
      </Grid>
    </Border>

    <Grid
        Grid.Row="1"
        IsVisible="{Binding IsCampaignUiVisible}"
        ColumnDefinitions="210,*,300">

      <Border
          Grid.Column="0"
          Background="#0D131A"
          BorderBrush="#26313D"
          BorderThickness="0,0,1,0"
          Padding="14,18">
        <Grid RowDefinitions="Auto,*,Auto">
          <StackPanel Spacing="4">
            <TextBlock
                Text="GOVERNMENT"
                Classes="eyebrow"
                Margin="10,0,0,8" />

            <Grid ColumnDefinitions="4,*">
              <Border IsVisible="{Binding IsBriefingSelected}" Background="#55B8C7" CornerRadius="3" />
              <Button Grid.Column="1" Classes="nav" Content="◆  Briefing" Foreground="#86CBD6"
                      Command="{Binding NavigateCommand}" CommandParameter="Briefing" />
            </Grid>
            <Grid ColumnDefinitions="4,*">
              <Border IsVisible="{Binding IsGovernmentSelected}" Background="#AAB5C2" CornerRadius="3" />
              <Button Grid.Column="1" Classes="nav" Content="▣  Government" Foreground="#B9C5D3"
                      Command="{Binding NavigateCommand}" CommandParameter="Government" />
            </Grid>
            <Grid ColumnDefinitions="4,*">
              <Border IsVisible="{Binding IsCourtSelected}" Background="#A77BD7" CornerRadius="3" />
              <Button Grid.Column="1" Classes="nav" Content="♟  Court" Foreground="#C8ACE1"
                      Command="{Binding NavigateCommand}" CommandParameter="Court" />
            </Grid>
            <Grid ColumnDefinitions="4,*">
              <Border IsVisible="{Binding IsEconomySelected}" Background="#4FAE78" CornerRadius="3" />
              <Button Grid.Column="1" Classes="nav" Content="▥  Economy" Foreground="#92CAA5"
                      Command="{Binding NavigateCommand}" CommandParameter="Economy" />
            </Grid>

            <TextBlock
                Text="STATE"
                Classes="eyebrow"
                Margin="10,18,0,8" />
            <Grid ColumnDefinitions="4,*">
              <Border IsVisible="{Binding IsForeignAffairsSelected}" Background="#5E9DD9" CornerRadius="3" />
              <Button Grid.Column="1" Classes="nav" Content="◇  Foreign Affairs" Foreground="#8CBCE8"
                      Command="{Binding NavigateCommand}" CommandParameter="Foreign Affairs" />
            </Grid>
            <Grid ColumnDefinitions="4,*">
              <Border IsVisible="{Binding IsMilitarySelected}" Background="#D96C6C" CornerRadius="3" />
              <Button Grid.Column="1" Classes="nav" Content="⚑  Military" Foreground="#E99B9B"
                      Command="{Binding NavigateCommand}" CommandParameter="Military" />
            </Grid>
            <Grid ColumnDefinitions="4,*">
              <Border IsVisible="{Binding IsIntelligenceSelected}" Background="#55B8C7" CornerRadius="3" />
              <Button Grid.Column="1" Classes="nav" Content="◉  Intelligence" Foreground="#86CBD6"
                      Command="{Binding NavigateCommand}" CommandParameter="Intelligence" />
            </Grid>
            <Grid ColumnDefinitions="4,*">
              <Border IsVisible="{Binding IsArchiveSelected}" Background="#7F8A98" CornerRadius="3" />
              <Button Grid.Column="1" Classes="nav" Content="▤  Archive" Foreground="#AAB5C2"
                      Command="{Binding NavigateCommand}" CommandParameter="Archive" />
            </Grid>
          </StackPanel>

          <Border
              Grid.Row="2"
              Classes="card"
              Padding="12"
              Margin="0,16,0,0">
            <StackPanel Spacing="7">
              <TextBlock Text="CAMPAIGN" Classes="eyebrow" />
              <TextBlock
                  Text="{Binding View.Campaign.ScenarioName}"
                  FontWeight="SemiBold"
                  TextWrapping="Wrap" />
              <TextBlock
                  Text="{Binding View.Campaign.CompletedObjectives, StringFormat='{}{0} objectives completed'}"
                  FontSize="11"
                  Classes="muted" />
              <Button
                  Margin="0,5,0,0"
                  Classes="action"
                  Command="{Binding OpenCampaignSetupCommand}"
                  Content="New / load campaign" />
            </StackPanel>
          </Border>
        </Grid>
      </Border>

      <Grid
          Grid.Column="1"
          Margin="24,22"
          ClipToBounds="True">

        <!-- Briefing -->
        <ScrollViewer IsVisible="{Binding IsBriefingVisible}">
          <StackPanel Spacing="20">
            <StackPanel Spacing="7">
              <TextBlock Text="BRIEFING" Classes="eyebrow" Foreground="#70C4D0" />
              <TextBlock
                  Text="What the government thinks it knows"
                  Classes="title" />
              <TextBlock
                  Text="Estimates can be stale, incomplete or wrong. Open Intelligence to inspect their sources."
                  TextWrapping="Wrap"
                  Classes="muted" />
              <WrapPanel Orientation="Horizontal" Margin="0,5,0,0">
                <Border Classes="badge" Background="#14241C" Margin="0,0,7,0">
                  <TextBlock Text="● Economy" Foreground="#75C493" FontSize="11" />
                </Border>
                <Border Classes="badge" Background="#261718" Margin="0,0,7,0">
                  <TextBlock Text="● Military" Foreground="#E28585" FontSize="11" />
                </Border>
                <Border Classes="badge" Background="#211827" Margin="0,0,7,0">
                  <TextBlock Text="● Politics" Foreground="#C096E2" FontSize="11" />
                </Border>
                <Border Classes="badge" Background="#13202B" Margin="0,0,7,0">
                  <TextBlock Text="● Diplomacy / Intel" Foreground="#74B8E8" FontSize="11" />
                </Border>
                <Border Classes="badge" Background="#261F14">
                  <TextBlock Text="▲ Stale / uncertain" Foreground="#D8A657" FontSize="11" />
                </Border>
              </WrapPanel>
            </StackPanel>

            <Border
                IsVisible="{Binding View.HasWon}"
                Background="#14281C"
                BorderBrush="#3E8058"
                BorderThickness="1"
                CornerRadius="8"
                Padding="14">
              <StackPanel Spacing="5">
                <TextBlock Text="CAMPAIGN VICTORY" Classes="eyebrow" Foreground="#8FD2A8" />
                <TextBlock
                    Text="{Binding View.WinReason}"
                    FontSize="16"
                    FontWeight="SemiBold"
                    TextWrapping="Wrap" />
              </StackPanel>
            </Border>

            <Border
                IsVisible="{Binding View.HasLost}"
                Background="#2B1718"
                BorderBrush="#764044"
                BorderThickness="1"
                CornerRadius="8"
                Padding="14">
              <StackPanel Spacing="5">
                <TextBlock Text="POLITICAL DEFEAT" Classes="eyebrow" Foreground="#E99B9B" />
                <TextBlock
                    Text="{Binding View.LossReason}"
                    FontSize="16"
                    FontWeight="SemiBold"
                    TextWrapping="Wrap" />
              </StackPanel>
            </Border>

            <Border Classes="panel">
              <StackPanel Spacing="11">
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel>
                    <TextBlock Text="CAMPAIGN OBJECTIVES" Classes="eyebrow" Foreground="#D8A657" />
                    <TextBlock
                        Text="{Binding View.Campaign.ScenarioName}"
                        FontSize="17"
                        FontWeight="SemiBold" />
                  </StackPanel>
                  <Border Grid.Column="1" Classes="badge" Background="#2A2115" VerticalAlignment="Top">
                    <TextBlock
                        Text="{Binding View.Campaign.CompletedObjectives, StringFormat='{}{0} complete'}"
                        Foreground="#E1B66F"
                        FontSize="11" />
                  </Border>
                </Grid>
                <TextBlock
                    Text="{Binding View.Campaign.Summary}"
                    TextWrapping="Wrap"
                    FontSize="12"
                    Classes="muted" />
                <ItemsControl ItemsSource="{Binding View.Campaign.Objectives}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border
                          Background="#0D141C"
                          BorderBrush="#26313D"
                          BorderThickness="1"
                          CornerRadius="6"
                          Padding="10"
                          Margin="0,0,0,6">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="9">
                          <TextBlock
                              Text="✓"
                              IsVisible="{Binding IsCompleted}"
                              Foreground="#75C493"
                              FontWeight="Bold"
                              FontSize="16" />
                          <StackPanel Grid.Column="1" Spacing="3">
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                            <TextBlock
                                Text="{Binding Description}"
                                TextWrapping="Wrap"
                                FontSize="11"
                                Classes="muted" />
                          </StackPanel>
                          <Border Grid.Column="2" Classes="badge" Background="#171E27" VerticalAlignment="Top">
                            <TextBlock
                                Text="{Binding Progress}"
                                FontSize="10"
                                Foreground="#C8D2DD" />
                          </Border>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>

            <ItemsControl ItemsSource="{Binding View.Metrics}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border
                      Classes="card"
                      Width="235"
                      MinHeight="122"
                      Margin="0,0,10,10"
                      Padding="0"
                      BorderBrush="{Binding IsStale, Converter={StaticResource StaleBrush}}">
                    <Grid RowDefinitions="5,*">
                      <Border
                          Background="{Binding Label, Converter={StaticResource MetricAccentBrush}}"
                          CornerRadius="8,8,0,0" />
                      <StackPanel Grid.Row="1" Spacing="6" Margin="14,11,14,13">
                        <Grid ColumnDefinitions="*,Auto">
                          <TextBlock Text="{Binding Label}" Classes="eyebrow" />
                          <Border
                              Grid.Column="1"
                              Classes="badge"
                              Background="#2A2115"
                              IsVisible="{Binding IsStale}"
                              Padding="6,2">
                            <TextBlock
                                Text="STALE"
                                FontSize="9"
                                FontWeight="Bold"
                                Foreground="#E1B66F" />
                          </Border>
                        </Grid>
                        <TextBlock
                            Text="{Binding Value}"
                            FontSize="23"
                            FontWeight="SemiBold"
                            Foreground="#F1F5F9" />
                        <TextBlock
                            Text="{Binding Detail}"
                            FontSize="11"
                            TextWrapping="Wrap"
                            Classes="muted" />
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Grid ColumnDefinitions="*,Auto">
              <StackPanel>
                <TextBlock Text="INCOMING" Classes="eyebrow" Foreground="#A9B7C6" />
                <TextBlock
                    Text="Reports, events and decisions"
                    Classes="section" />
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                <Border Classes="badge" Background="#1B2430">
                  <TextBlock
                      Text="{Binding View.PendingOrders, StringFormat='{}{0} orders queued'}"
                      FontSize="11"
                      Foreground="#C4D0DD" />
                </Border>
                <Border Classes="badge" Background="#13252B">
                  <TextBlock
                      Text="{Binding View.PendingReports, StringFormat='{}{0} inquiries underway'}"
                      FontSize="11"
                      Foreground="#86CBD6" />
                </Border>
              </StackPanel>
            </Grid>

            <StackPanel IsVisible="{Binding HasCabinetProposals}" Spacing="8">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel>
                  <TextBlock Text="CABINET DECISIONS" Classes="eyebrow" Foreground="#C096E2" />
                  <TextBlock Text="Recommendations awaiting your answer" Classes="section" />
                </StackPanel>
                <Border Grid.Column="1" Classes="badge" Background="#211827" VerticalAlignment="Center">
                  <TextBlock
                      Text="{Binding View.CabinetProposals.Count, StringFormat='{}{0} awaiting'}"
                      Foreground="#C8ACE1"
                      FontSize="11" />
                </Border>
              </Grid>

              <ItemsControl ItemsSource="{Binding View.CabinetProposals}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Classes="card" Margin="0,0,0,8" Padding="0">
                      <Grid ColumnDefinitions="5,*">
                        <Border
                            Background="{Binding Office, Converter={StaticResource AdvisorRoleBrush}}"
                            CornerRadius="8,0,0,8" />
                        <Grid Grid.Column="1" ColumnDefinitions="*,Auto" ColumnSpacing="14" Margin="14">
                          <StackPanel Spacing="6">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                              <Border
                                  Classes="badge"
                                  Background="{Binding Office, Converter={StaticResource AdvisorRoleBrush}}">
                                <TextBlock
                                    Text="{Binding Office}"
                                    FontSize="9"
                                    FontWeight="Bold"
                                    Foreground="#081016" />
                              </Border>
                              <TextBlock
                                  Text="{Binding Advisor}"
                                  VerticalAlignment="Center"
                                  FontSize="11"
                                  Classes="muted" />
                              <TextBlock
                                  Text="{Binding Age}"
                                  VerticalAlignment="Center"
                                  FontSize="10"
                                  Foreground="#D8A657" />
                            </StackPanel>
                            <TextBlock
                                Text="{Binding Title}"
                                FontSize="17"
                                FontWeight="SemiBold"
                                TextWrapping="Wrap" />
                            <TextBlock
                                Text="{Binding Description}"
                                TextWrapping="Wrap"
                                Foreground="#C8D2DD" />
                          </StackPanel>

                          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                            <Button
                                Classes="action politics"
                                Command="{Binding #Root.DataContext.AcceptCabinetProposalCommand}"
                                CommandParameter="{Binding}"
                                Content="Accept" />
                            <Button
                                Classes="action"
                                Command="{Binding #Root.DataContext.RejectCabinetProposalCommand}"
                                CommandParameter="{Binding}"
                                Content="Reject" />
                          </StackPanel>
                        </Grid>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
              <Border Classes="card" Background="#141A22">
                <StackPanel Spacing="9">
                  <Grid ColumnDefinitions="*,Auto">
                    <StackPanel>
                      <TextBlock Text="ORDERS DESK" Classes="eyebrow" Foreground="#D8A657" />
                      <TextBlock Text="Awaiting execution" FontWeight="SemiBold" />
                    </StackPanel>
                    <Border Grid.Column="1" Classes="badge" Background="#2A2115" VerticalAlignment="Top">
                      <TextBlock
                          Text="{Binding View.PendingOrders}"
                          Foreground="#E1B66F"
                          FontWeight="Bold"
                          FontSize="11" />
                    </Border>
                  </Grid>

                  <ItemsControl ItemsSource="{Binding View.PendingOrderDetails}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border
                            Background="#0E151D"
                            BorderBrush="#26313D"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="9"
                            Margin="0,0,0,6">
                          <StackPanel Spacing="4">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                              <Border Classes="badge" Background="#3A2C16">
                                <TextBlock
                                    Text="{Binding Type}"
                                    FontSize="9"
                                    FontWeight="Bold"
                                    Foreground="#E1B66F" />
                              </Border>
                              <TextBlock
                                  Grid.Column="1"
                                  Text="{Binding Recipient}"
                                  Margin="8,0,0,0"
                                  VerticalAlignment="Center"
                                  FontSize="11"
                                  Classes="muted" />
                              <TextBlock
                                  Grid.Column="2"
                                  Text="{Binding IssuedOn}"
                                  FontSize="10"
                                  Classes="muted" />
                            </Grid>
                            <TextBlock
                                Text="{Binding Description}"
                                TextWrapping="Wrap"
                                Foreground="#D7E0E9" />
                          </StackPanel>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>

              <Border Grid.Column="1" Classes="card" Background="#141A22">
                <StackPanel Spacing="9">
                  <StackPanel>
                    <TextBlock Text="ORDER RESULTS" Classes="eyebrow" Foreground="#86CBD6" />
                    <TextBlock Text="Recent resolutions" FontWeight="SemiBold" />
                  </StackPanel>

                  <ItemsControl ItemsSource="{Binding View.RecentOrderOutcomes}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border
                            Background="{Binding NeedsAttention, Converter={StaticResource AttentionBackground}}"
                            BorderBrush="#26313D"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="9"
                            Margin="0,0,0,6">
                          <Grid ColumnDefinitions="5,*">
                            <Border
                                Background="{Binding NeedsAttention, Converter={StaticResource StaleBrush}}"
                                CornerRadius="3" />
                            <StackPanel Grid.Column="1" Margin="8,0,0,0" Spacing="4">
                              <Grid ColumnDefinitions="*,Auto">
                                <TextBlock
                                    Text="{Binding Title}"
                                    FontWeight="SemiBold"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    Grid.Column="1"
                                    Text="{Binding Date}"
                                    FontSize="10"
                                    Classes="muted" />
                              </Grid>
                              <TextBlock
                                  Text="{Binding Details}"
                                  TextWrapping="Wrap"
                                  FontSize="11"
                                  Foreground="#B7C2CE" />
                            </StackPanel>
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>
            </Grid>

            <ItemsControl ItemsSource="{Binding View.Briefings}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border
                      Classes="card"
                      Margin="0,0,0,10"
                      Background="{Binding NeedsAttention, Converter={StaticResource AttentionBackground}}">
                    <Grid ColumnDefinitions="5,*">
                      <Border
                          Background="{Binding Category, Converter={StaticResource CategoryBrush}}"
                          CornerRadius="4"
                          Margin="-5,0,12,0" />
                      <StackPanel Grid.Column="1" Spacing="7">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                          <Border
                              Classes="badge"
                              Background="{Binding Category, Converter={StaticResource CategoryBrush}}"
                              Padding="8,3">
                            <TextBlock
                                Text="{Binding Category}"
                                FontSize="10"
                                FontWeight="Bold"
                                Foreground="#081016" />
                          </Border>
                          <TextBlock
                              Grid.Column="1"
                              Text="{Binding Meta}"
                              FontSize="11"
                              Classes="muted"
                              VerticalAlignment="Center"
                              Margin="9,0,0,0" />
                          <Border
                              Grid.Column="2"
                              Classes="badge"
                              Background="#2B2114"
                              IsVisible="{Binding NeedsAttention}">
                            <TextBlock
                                Text="▲ ATTENTION"
                                FontSize="9"
                                FontWeight="Bold"
                                Foreground="#E3B76C" />
                          </Border>
                        </Grid>
                        <TextBlock
                            Text="{Binding Title}"
                            FontSize="17"
                            FontWeight="SemiBold"
                            TextWrapping="Wrap" />
                        <TextBlock
                            Text="{Binding Summary}"
                            TextWrapping="Wrap"
                            Foreground="#C6D0DB" />
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>

        <!-- Government -->
        <ScrollViewer IsVisible="{Binding IsGovernmentVisible}">
          <StackPanel Spacing="20">
            <StackPanel Spacing="5">
              <TextBlock Text="GOVERNMENT" Classes="eyebrow" Foreground="#AAB5C2" />
              <TextBlock Text="Policy and administration" Classes="title" />
              <TextBlock
                  Text="You know what policy was formally enacted. Its real effects remain something your officials must report back to you."
                  TextWrapping="Wrap"
                  Classes="muted" />
            </StackPanel>

            <Border Classes="panel" Background="#151922" BorderBrush="#3A4656">
              <StackPanel Spacing="14">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="20">
                  <StackPanel Spacing="5">
                    <TextBlock Text="CONSTITUTIONAL ORDER" Classes="eyebrow" Foreground="#8CBCE8" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <TextBlock
                          Text="{Binding View.Government.Regime}"
                          FontSize="18"
                          FontWeight="SemiBold" />
                      <Border Classes="badge" Background="#13202B">
                        <TextBlock
                            Text="{Binding View.Government.PoliticalCycle}"
                            FontSize="10"
                            Foreground="#8CBCE8" />
                      </Border>
                    </StackPanel>
                    <TextBlock
                        Text="{Binding View.Government.PoliticalCycleDetail}"
                        MaxWidth="760"
                        TextWrapping="Wrap"
                        Classes="muted" />
                  </StackPanel>
                  <TextBlock
                      Grid.Column="1"
                      Text="◇"
                      IsVisible="{Binding View.Government.HasElection}"
                      FontSize="30"
                      Foreground="#70C4D0"
                      VerticalAlignment="Center" />
                </Grid>

                <Border
                    Background="#111820"
                    BorderBrush="#354454"
                    BorderThickness="1"
                    CornerRadius="7"
                    Padding="12">
                  <StackPanel Spacing="9">
                    <Grid ColumnDefinitions="*,Auto">
                      <StackPanel Spacing="3">
                        <TextBlock Text="LAWMAKING" Classes="eyebrow" Foreground="#AAB5C2" />
                        <TextBlock
                            Text="{Binding View.Government.LegislativeBody}"
                            FontSize="16"
                            FontWeight="SemiBold" />
                      </StackPanel>
                      <Border Grid.Column="1" Classes="badge" Background="#171E27" VerticalAlignment="Top">
                        <TextBlock
                            Text="Institutional route"
                            FontSize="10"
                            Foreground="#B9C5D3" />
                      </Border>
                    </Grid>
                    <TextBlock
                        Text="{Binding View.Government.LegislativeAuthority}"
                        TextWrapping="Wrap"
                        Classes="muted" />

                    <ItemsControl
                        IsVisible="{Binding View.Government.HasLegislation}"
                        ItemsSource="{Binding View.Government.Legislation}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Border
                              Background="#151D26"
                              BorderBrush="#2C3947"
                              BorderThickness="1"
                              CornerRadius="6"
                              Padding="10"
                              Margin="0,3,0,0">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                              <StackPanel Spacing="3">
                                <TextBlock
                                    Text="{Binding Title}"
                                    FontWeight="SemiBold" />
                                <TextBlock
                                    Text="{Binding Detail}"
                                    TextWrapping="Wrap"
                                    FontSize="11"
                                    Classes="muted" />
                                <TextBlock
                                    Text="{Binding Age}"
                                    FontSize="10"
                                    Classes="muted" />
                              </StackPanel>
                              <Border Grid.Column="1" Classes="badge" Background="#202934" VerticalAlignment="Top">
                                <TextBlock
                                    Text="{Binding Status}"
                                    FontSize="10"
                                    Foreground="#C6D0DB" />
                              </Border>
                            </Grid>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </Border>

                <Border
                    Background="#131A18"
                    BorderBrush="#35453E"
                    BorderThickness="1"
                    CornerRadius="7"
                    Padding="12">
                  <StackPanel Spacing="10">
                    <Grid ColumnDefinitions="*,Auto">
                      <StackPanel Spacing="3">
                        <TextBlock Text="ADMINISTRATION &amp; OFFICES" Classes="eyebrow" Foreground="#86B49A" />
                        <TextBlock
                            Text="{Binding View.Government.AdministrativeEfficiency}"
                            FontSize="16"
                            FontWeight="SemiBold" />
                      </StackPanel>
                      <TextBlock
                          Grid.Column="1"
                          Text="Formal law is not the same as effective execution."
                          MaxWidth="330"
                          TextWrapping="Wrap"
                          TextAlignment="Right"
                          FontSize="11"
                          Classes="muted" />
                    </Grid>

                    <ItemsControl ItemsSource="{Binding View.Government.AdministrativeOffices}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Border
                              Background="#151D1A"
                              BorderBrush="#2D3D35"
                              BorderThickness="1"
                              CornerRadius="6"
                              Padding="10"
                              Margin="0,3,0,0">
                            <Grid ColumnDefinitions="1.35*,1.25*,0.9*,0.85*,0.85*,1.25*" ColumnSpacing="12">
                              <StackPanel Spacing="2">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Function}" FontSize="10" Classes="muted" />
                              </StackPanel>
                              <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock Text="Responsible" Classes="eyebrow" FontSize="9" />
                                <TextBlock Text="{Binding Head}" FontSize="11" />
                              </StackPanel>
                              <StackPanel Grid.Column="2" Spacing="2">
                                <TextBlock Text="Performance" Classes="eyebrow" FontSize="9" />
                                <TextBlock Text="{Binding Performance}" FontSize="11" />
                              </StackPanel>
                              <StackPanel Grid.Column="3" Spacing="2">
                                <TextBlock Text="Reach" Classes="eyebrow" FontSize="9" />
                                <TextBlock Text="{Binding Reach}" FontSize="11" />
                              </StackPanel>
                              <StackPanel Grid.Column="4" Spacing="2">
                                <TextBlock Text="Workload" Classes="eyebrow" FontSize="9" />
                                <TextBlock Text="{Binding Workload}" FontSize="11" />
                              </StackPanel>
                              <StackPanel Grid.Column="5" Spacing="2">
                                <TextBlock Text="Institution" Classes="eyebrow" FontSize="9" />
                                <TextBlock Text="{Binding Structure}" TextWrapping="Wrap" FontSize="10" Classes="muted" />
                              </StackPanel>
                            </Grid>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </Border>

                <Border
                    IsVisible="{Binding View.Government.HasElection}"
                    Background="#101821"
                    BorderBrush="#294052"
                    BorderThickness="1"
                    CornerRadius="7"
                    Padding="12">
                  <StackPanel Spacing="9">
                    <Grid ColumnDefinitions="*,Auto">
                      <StackPanel Spacing="3">
                        <TextBlock Text="PUBLIC ELECTION COMMITMENT" Classes="eyebrow" Foreground="#70C4D0" />
                        <TextBlock
                            Text="{Binding View.Government.ElectionPromise}"
                            FontWeight="SemiBold"
                            TextWrapping="Wrap" />
                      </StackPanel>
                      <Border Grid.Column="1" Classes="badge" Background="#13202B" VerticalAlignment="Top">
                        <TextBlock
                            Text="{Binding View.Government.ElectionPromiseStatus}"
                            FontSize="10"
                            Foreground="#8CBCE8" />
                      </Border>
                    </Grid>

                    <Grid
                        IsVisible="{Binding View.Government.IsElectionCampaignActive}"
                        ColumnDefinitions="*,Auto"
                        ColumnSpacing="9">
                      <ComboBox
                          ItemsSource="{Binding ElectionPromiseOptions}"
                          SelectedItem="{Binding SelectedElectionPromise, Mode=TwoWay}"
                          IsEnabled="{Binding View.Government.CanMakeElectionPromise}"
                          MinWidth="240" />
                      <Button
                          Grid.Column="1"
                          Classes="action politics"
                          Command="{Binding MakeElectionPromiseCommand}"
                          IsEnabled="{Binding View.Government.CanMakeElectionPromise}"
                          Content="Make public promise" />
                    </Grid>

                    <TextBlock
                        IsVisible="{Binding View.Government.IsElectionCampaignActive}"
                        Text="One principal promise may be made per election. It helps the constituencies it targets now, but if your nominee wins you have six months to actually deliver it."
                        TextWrapping="Wrap"
                        FontSize="11"
                        Classes="muted" />
                  </StackPanel>
                </Border>
              </StackPanel>
            </Border>

            <Border Classes="panel">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="20">
                <StackPanel Spacing="4">
                  <TextBlock Text="TREASURY" Classes="eyebrow" Foreground="#75C493" />
                  <TextBlock
                      Text="{Binding View.Government.TreasurerName}"
                      FontSize="18"
                      FontWeight="SemiBold" />
                  <TextBlock
                      Text="{Binding View.Government.PolicyNote}"
                      MaxWidth="680"
                      TextWrapping="Wrap"
                      Classes="muted" />
                </StackPanel>
                <Border Grid.Column="1" Classes="badge" Background="#171E27" VerticalAlignment="Top">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="Obedience" Classes="muted" FontSize="11" />
                    <TextBlock
                        Text="{Binding View.Government.TreasurerObedience}"
                        FontWeight="SemiBold"
                        FontSize="11"
                        Foreground="{Binding View.Government.TreasurerObedience, Converter={StaticResource SemanticStatusBrush}}" />
                  </StackPanel>
                </Border>
              </Grid>
            </Border>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
              <Border Classes="card">
                <StackPanel Spacing="12">
                  <TextBlock Text="TAX POLICY" Classes="eyebrow" Foreground="#75C493" />
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="Official tax rate" Classes="muted" />
                    <TextBlock
                        Grid.Column="1"
                        Text="{Binding View.Government.TaxPercent, StringFormat='{}{0:F0}%'}"
                        FontSize="20"
                        FontWeight="SemiBold"
                        Foreground="#8FD2A8" />
                  </Grid>
                  <Slider
                      Minimum="0"
                      Maximum="60"
                      TickFrequency="1"
                      Value="{Binding TargetTaxPercent, Mode=TwoWay}" />
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock
                        Text="{Binding TargetTaxPercent, StringFormat='Target: {0:F0}%'}"
                        VerticalAlignment="Center"
                        Foreground="#C6D0DB" />
                    <Button
                        Grid.Column="1"
                        Classes="action economy"
                        Command="{Binding ApplyTaxCommand}"
                        Content="Issue tax directive" />
                  </Grid>
                </StackPanel>
              </Border>

              <Border Grid.Column="1" Classes="card">
                <StackPanel Spacing="12">
                  <TextBlock Text="FORMAL FUNDING" Classes="eyebrow" Foreground="#D8A657" />
                  <TextBlock
                      Text="The budget is an order to the Treasury. What is actually achieved can still differ."
                      TextWrapping="Wrap"
                      Classes="muted"
                      FontSize="12" />
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="Army" />
                    <TextBlock
                        Grid.Column="1"
                        Text="{Binding TargetArmyFundingPercent, StringFormat='{}{0:F0}%'}"
                        Foreground="#E99B9B"
                        FontWeight="SemiBold" />
                  </Grid>
                  <Slider Minimum="50" Maximum="150" TickFrequency="5"
                          Value="{Binding TargetArmyFundingPercent, Mode=TwoWay}" />

                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="Administration" />
                    <TextBlock
                        Grid.Column="1"
                        Text="{Binding TargetAdministrationFundingPercent, StringFormat='{}{0:F0}%'}"
                        Foreground="#8CBCE8"
                        FontWeight="SemiBold" />
                  </Grid>
                  <Slider Minimum="50" Maximum="150" TickFrequency="5"
                          Value="{Binding TargetAdministrationFundingPercent, Mode=TwoWay}" />

                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="Court &amp; patronage" />
                    <TextBlock
                        Grid.Column="1"
                        Text="{Binding TargetCourtFundingPercent, StringFormat='{}{0:F0}%'}"
                        Foreground="#C8ACE1"
                        FontWeight="SemiBold" />
                  </Grid>
                  <Slider Minimum="50" Maximum="150" TickFrequency="5"
                          Value="{Binding TargetCourtFundingPercent, Mode=TwoWay}" />

                  <Button
                      Classes="action politics"
                      HorizontalAlignment="Right"
                      Command="{Binding ApplyBudgetCommand}"
                      Content="Issue budget directive" />
                </StackPanel>
              </Border>
            </Grid>

            <Border Background="#151D26" CornerRadius="8" Padding="12">
              <StackPanel Orientation="Horizontal" Spacing="9">
                <TextBlock Text="◆" Foreground="#86CBD6" />
                <TextBlock
                    Text="Orders are queued. Advance the month to see whether your officials obey, moderate or refuse them."
                    TextWrapping="Wrap"
                    Foreground="#AEBAC8" />
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>

        <!-- Court -->
        <ScrollViewer IsVisible="{Binding IsCourtVisible}">
          <StackPanel Spacing="20">
            <StackPanel Spacing="5">
              <TextBlock Text="COURT" Classes="eyebrow" Foreground="#C096E2" />
              <TextBlock Text="People who can make or break the regime" Classes="title" />
              <TextBlock
                  Text="Political traits are impressions, not instrument readings. Appointing a popular figure can buy support while making that person more dangerous."
                  TextWrapping="Wrap"
                  Classes="muted" />
            </StackPanel>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
              <Border Classes="card" Background="#17131C" BorderBrush="#513A62">
                <StackPanel Spacing="7">
                  <TextBlock Text="ORGANISED OPPOSITION" Classes="eyebrow" Foreground="#C096E2" />
                  <TextBlock
                      Text="{Binding View.Court.KnownOpposition}"
                      TextWrapping="Wrap"
                      Foreground="#D8C9E4" />
                </StackPanel>
              </Border>
              <Border Grid.Column="1" Classes="card" Background="#211A12" BorderBrush="#6D542D">
                <StackPanel Spacing="7">
                  <TextBlock Text="POLITICAL PRESSURE" Classes="eyebrow" Foreground="#D8A657" />
                  <TextBlock
                      Text="{Binding View.Court.KnownPressure}"
                      TextWrapping="Wrap"
                      Foreground="#DDC79E" />
                </StackPanel>
              </Border>
            </Grid>

            <Border
                IsVisible="{Binding View.Court.IsPlayerInOpposition}"
                Classes="panel"
                Background="#17131C"
                BorderBrush="#513A62">
              <StackPanel Spacing="12">
                <StackPanel Spacing="4">
                  <TextBlock Text="OPPOSITION STRATEGY" Classes="eyebrow" Foreground="#C096E2" />
                  <TextBlock
                      Text="{Binding View.Court.OppositionStatus}"
                      TextWrapping="Wrap"
                      Foreground="#D8C9E4" />
                </StackPanel>

                <Grid ColumnDefinitions="220,*,*,*" ColumnSpacing="8">
                  <ComboBox
                      ItemsSource="{Binding OppositionPowerBaseOptions}"
                      SelectedItem="{Binding SelectedOppositionPowerBase, Mode=TwoWay}"
                      IsEnabled="{Binding View.Court.CanTakeOppositionAction}"
                      VerticalAlignment="Center" />
                  <Button
                      Grid.Column="1"
                      Classes="action politics"
                      Command="{Binding OrganiseOppositionSupportCommand}"
                      IsEnabled="{Binding View.Court.CanTakeOppositionAction}"
                      Content="Organise supporters" />
                  <Button
                      Grid.Column="2"
                      Classes="action politics"
                      Command="{Binding BuildOppositionCoalitionCommand}"
                      IsEnabled="{Binding View.Court.CanTakeOppositionAction}"
                      Content="Build coalition" />
                  <Button
                      Grid.Column="3"
                      Classes="action"
                      Command="{Binding ApplyOppositionPressureCommand}"
                      IsEnabled="{Binding View.Court.CanTakeOppositionAction}"
                      Content="Apply public pressure" />
                </Grid>

                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="14">
                  <TextBlock
                      Text="Low risk: deepen your own network and standing with the selected constituency."
                      TextWrapping="Wrap"
                      FontSize="11"
                      Classes="muted" />
                  <TextBlock
                      Grid.Column="1"
                      Text="Court political figures and turn shared interests into a broader opposition network."
                      TextWrapping="Wrap"
                      FontSize="11"
                      Classes="muted" />
                  <TextBlock
                      Grid.Column="2"
                      Text="Higher risk: mobilise supporters openly against the government. Weak backing can make the campaign backfire."
                      TextWrapping="Wrap"
                      FontSize="11"
                      Classes="muted" />
                </Grid>
              </StackPanel>
            </Border>

            <StackPanel Spacing="8">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel>
                  <TextBlock Text="ACTIVE DEMANDS" Classes="eyebrow" Foreground="#D8A657" />
                  <TextBlock Text="Petitions that require a political answer" FontWeight="SemiBold" />
                </StackPanel>
                <Border Grid.Column="1" Classes="badge" Background="#2A2115" VerticalAlignment="Center">
                  <TextBlock
                      Text="{Binding View.Court.Demands.Count, StringFormat='{}{0} active'}"
                      Foreground="#E1B66F"
                      FontSize="11" />
                </Border>
              </Grid>

              <ItemsControl ItemsSource="{Binding View.Court.Demands}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Classes="card" Margin="0,0,0,8" Background="#1A1712" BorderBrush="#5B492B">
                      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                        <StackPanel Spacing="6">
                          <StackPanel Orientation="Horizontal" Spacing="8">
                            <Border Classes="badge" Background="#3A2C16">
                              <TextBlock
                                  Text="{Binding Group}"
                                  FontSize="10"
                                  FontWeight="Bold"
                                  Foreground="#E1B66F" />
                            </Border>
                            <TextBlock
                                Text="{Binding Spokesperson}"
                                VerticalAlignment="Center"
                                FontSize="11"
                                Foreground="#D7C9AE" />
                          </StackPanel>
                          <TextBlock
                              Text="{Binding Request}"
                              FontSize="15"
                              FontWeight="SemiBold"
                              TextWrapping="Wrap" />
                          <WrapPanel Orientation="Horizontal">
                            <TextBlock
                                Text="{Binding Age}"
                                Margin="0,0,14,0"
                                FontSize="11"
                                Classes="muted" />
                            <TextBlock
                                Text="{Binding Escalation, StringFormat='Pressure: {0}'}"
                                Margin="0,0,14,0"
                                FontSize="11"
                                Foreground="#D8A657" />
                            <TextBlock
                                Text="{Binding ResponseStatus}"
                                FontSize="11"
                                Foreground="#C8ACE1" />
                          </WrapPanel>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                          <Button
                              Classes="action politics"
                              Command="{Binding #Root.DataContext.ConcedePoliticalDemandCommand}"
                              CommandParameter="{Binding}"
                              Content="Concede" />
                          <Button
                              Classes="action"
                              Command="{Binding #Root.DataContext.RejectPoliticalDemandCommand}"
                              CommandParameter="{Binding}"
                              Content="Reject" />
                        </StackPanel>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <TextBlock
                  Text="Conceding queues the actual policy order. The group remains dissatisfied until the responsible official really delivers it. Rejecting closes the petition but creates an immediate grievance."
                  TextWrapping="Wrap"
                  FontSize="11"
                  Classes="muted" />
            </StackPanel>

            <StackPanel Spacing="8">
              <TextBlock Text="OFFICES" Classes="eyebrow" />
              <ItemsControl ItemsSource="{Binding View.Court.Offices}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Classes="card" Width="245" Margin="0,0,10,10">
                      <StackPanel Spacing="6">
                        <TextBlock Text="{Binding Position}" Classes="eyebrow" Foreground="#C096E2" />
                        <TextBlock Text="{Binding HolderName}" FontSize="17" FontWeight="SemiBold" />
                        <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="4" ColumnSpacing="12">
                          <TextBlock Text="Ability" Classes="muted" />
                          <TextBlock Grid.Column="1" Text="{Binding Ability}"
                                     Foreground="{Binding Ability, Converter={StaticResource SemanticStatusBrush}}" />
                          <TextBlock Grid.Row="1" Text="Trust" Classes="muted" />
                          <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Trust}"
                                     Foreground="{Binding Trust, Converter={StaticResource SemanticStatusBrush}}" />
                          <TextBlock Grid.Row="2" Text="Obedience" Classes="muted" />
                          <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Obedience}"
                                     Foreground="{Binding Obedience, Converter={StaticResource SemanticStatusBrush}}" />
                          <TextBlock Grid.Row="3" Text="Risk" Classes="muted" />
                          <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Risk}"
                                     Foreground="{Binding Risk, Converter={StaticResource RiskBrush}}" FontWeight="Bold" />
                        </Grid>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>

            <Border Classes="panel">
              <StackPanel Spacing="12">
                <TextBlock Text="PATRONAGE &amp; APPOINTMENTS" Classes="eyebrow" Foreground="#C096E2" />
                <Grid ColumnDefinitions="*,180,Auto,Auto" ColumnSpacing="8">
                  <ComboBox
                      ItemsSource="{Binding AppointmentCandidates}"
                      SelectedItem="{Binding SelectedCourtFigure}"
                      PlaceholderText="Choose political figure">
                    <ComboBox.ItemTemplate>
                      <DataTemplate>
                        <StackPanel>
                          <TextBlock Text="{Binding Name}" />
                          <TextBlock
                              Text="{Binding Risk, StringFormat='Risk: {0}'}"
                              FontSize="10"
                              Foreground="{Binding Risk, Converter={StaticResource RiskBrush}}" />
                        </StackPanel>
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                  <ComboBox
                      Grid.Column="1"
                      ItemsSource="{Binding OfficeOptions}"
                      SelectedItem="{Binding SelectedOffice}" />
                  <Button
                      Grid.Column="2"
                      Classes="action politics"
                      Command="{Binding AppointAdvisorCommand}"
                      Content="Appoint" />
                  <Button
                      Grid.Column="3"
                      Classes="action"
                      Command="{Binding DismissAdvisorCommand}"
                      Content="Dismiss holder" />
                </Grid>
                <TextBlock
                    Text="Appointments and dismissals are political acts: supporters notice, office creates access, and grievances can become organised opposition."
                    TextWrapping="Wrap"
                    FontSize="12"
                    Classes="muted" />
              </StackPanel>
            </Border>

            <StackPanel Spacing="8">
              <TextBlock Text="POLITICAL FIGURES" Classes="eyebrow" />
              <ItemsControl ItemsSource="{Binding View.Court.Figures}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Classes="card" Margin="0,0,0,9">
                      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="18">
                        <StackPanel Spacing="5">
                          <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" />
                            <Border Classes="badge" Background="#1C1722">
                              <TextBlock Text="{Binding Role}" FontSize="10" Foreground="#C8ACE1" />
                            </Border>
                          </StackPanel>
                          <TextBlock Text="{Binding Constituencies}" FontSize="11" Classes="muted" />
                          <Border
                              IsVisible="{Binding HasKnownEvidence}"
                              Background="#2A2115"
                              BorderBrush="#6D542D"
                              BorderThickness="1"
                              CornerRadius="5"
                              Padding="7,3"
                              HorizontalAlignment="Left">
                            <TextBlock
                                Text="{Binding KnownEvidence}"
                                FontSize="10"
                                FontWeight="SemiBold"
                                Foreground="#E1B66F" />
                          </Border>
                          <WrapPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Ability, StringFormat='Ability {0}'}" Margin="0,0,14,0"
                                       Foreground="{Binding Ability, Converter={StaticResource SemanticStatusBrush}}" />
                            <TextBlock Text="{Binding Ambition, StringFormat='Ambition {0}'}" Margin="0,0,14,0" />
                            <TextBlock Text="{Binding Influence, StringFormat='Influence {0}'}" Margin="0,0,14,0" />
                            <TextBlock Text="{Binding Trust, StringFormat='Trust {0}'}"
                                       Foreground="{Binding Trust, Converter={StaticResource SemanticStatusBrush}}" />
                          </WrapPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="1" HorizontalAlignment="Right" Spacing="6">
                          <Border Classes="badge" Background="#171E27">
                            <TextBlock
                                Text="{Binding Risk, StringFormat='Risk {0}'}"
                                Foreground="{Binding Risk, Converter={StaticResource RiskBrush}}"
                                FontWeight="Bold"
                                FontSize="11" />
                          </Border>
                          <TextBlock
                              Text="{Binding Obedience, StringFormat='Obedience: {0}'}"
                              FontSize="11"
                              HorizontalAlignment="Right"
                              Foreground="{Binding Obedience, Converter={StaticResource SemanticStatusBrush}}" />
                          <WrapPanel
                              Orientation="Horizontal"
                              HorizontalAlignment="Right"
                              Margin="0,3,0,0">
                            <Button
                                IsVisible="{Binding CanInvestigate}"
                                Margin="0,0,6,0"
                                Classes="action intelligence"
                                Command="{Binding #Root.DataContext.InvestigateCharacterCommand}"
                                CommandParameter="{Binding}"
                                Content="Investigate" />
                            <Button
                                IsVisible="{Binding CanArrest}"
                                Margin="0,0,6,0"
                                Classes="action military"
                                Command="{Binding #Root.DataContext.ArrestCharacterCommand}"
                                CommandParameter="{Binding}"
                                Content="Arrest" />
                            <Button
                                IsVisible="{Binding CanRelease}"
                                Classes="action politics"
                                Command="{Binding #Root.DataContext.ReleasePrisonerCommand}"
                                CommandParameter="{Binding}"
                                Content="Release" />
                          </WrapPanel>
                        </StackPanel>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>

        <!-- Economy -->
        <ScrollViewer IsVisible="{Binding IsEconomyVisible}">
          <StackPanel Spacing="20">
            <StackPanel Spacing="5">
              <TextBlock Text="ECONOMY" Classes="eyebrow" Foreground="#75C493" />
              <TextBlock Text="What the Treasury says is happening" Classes="title" />
              <TextBlock
                  Text="This screen is built from Treasurer reports. Historical entries preserve what the government believed at the time rather than silently replacing old claims with hidden truth."
                  TextWrapping="Wrap"
                  Classes="muted" />
            </StackPanel>

            <Border Classes="panel">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                <StackPanel Spacing="4">
                  <TextBlock Text="TREASURY" Classes="eyebrow" Foreground="#75C493" />
                  <TextBlock
                      Text="{Binding View.Economy.TreasurerName}"
                      FontSize="18"
                      FontWeight="SemiBold" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                  <Border Classes="badge" Background="#14241C">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <TextBlock Text="Obedience" Classes="muted" FontSize="11" />
                      <TextBlock
                          Text="{Binding View.Economy.TreasurerObedience}"
                          FontWeight="SemiBold"
                          FontSize="11"
                          Foreground="{Binding View.Economy.TreasurerObedience, Converter={StaticResource SemanticStatusBrush}}" />
                    </StackPanel>
                  </Border>
                  <Button
                      Classes="action economy"
                      Command="{Binding RequestEconomyReportCommand}"
                      Content="▥  Request fresh report" />
                </StackPanel>
              </Grid>
            </Border>

            <ItemsControl ItemsSource="{Binding View.Economy.Summary}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border
                      Classes="card"
                      Width="225"
                      MinHeight="118"
                      Margin="0,0,10,10"
                      Padding="0"
                      BorderBrush="{Binding IsStale, Converter={StaticResource StaleBrush}}">
                    <Grid RowDefinitions="5,*">
                      <Border
                          Background="{Binding Label, Converter={StaticResource MetricAccentBrush}}"
                          CornerRadius="8,8,0,0" />
                      <StackPanel Grid.Row="1" Margin="14,11,14,13" Spacing="6">
                        <Grid ColumnDefinitions="*,Auto">
                          <TextBlock Text="{Binding Label}" Classes="eyebrow" />
                          <Border
                              Grid.Column="1"
                              Classes="badge"
                              Background="#2A2115"
                              IsVisible="{Binding IsStale}"
                              Padding="6,2">
                            <TextBlock
                                Text="STALE"
                                FontSize="9"
                                FontWeight="Bold"
                                Foreground="#E1B66F" />
                          </Border>
                        </Grid>
                        <TextBlock
                            Text="{Binding Value}"
                            FontSize="21"
                            FontWeight="SemiBold" />
                        <TextBlock
                            Text="{Binding Detail}"
                            FontSize="11"
                            TextWrapping="Wrap"
                            Classes="muted" />
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Grid ColumnDefinitions="*,Auto">
              <StackPanel>
                <TextBlock Text="REPORTED HISTORY" Classes="eyebrow" Foreground="#75C493" />
                <TextBlock
                    Text="Successive Treasury snapshots"
                    Classes="section" />
              </StackPanel>
              <Border Grid.Column="1" Classes="badge" Background="#14241C" VerticalAlignment="Center">
                <TextBlock
                    Text="{Binding View.Economy.History.Count, StringFormat='{}{0} report(s) retained'}"
                    Foreground="#8FD2A8"
                    FontSize="11" />
              </Border>
            </Grid>

            <Border Classes="card" Padding="0">
              <Grid RowDefinitions="Auto,*">
                <Border Background="#0D141C" Padding="12,9">
                  <Grid
                      ColumnDefinitions="100,105,150,95,110,110,110,110,*"
                      ColumnSpacing="8">
                    <TextBlock Text="Delivered" Classes="eyebrow" />
                    <TextBlock Grid.Column="1" Text="Data age" Classes="eyebrow" />
                    <TextBlock Grid.Column="2" Text="Source" Classes="eyebrow" />
                    <TextBlock Grid.Column="3" Text="Treasury" Classes="eyebrow" />
                    <TextBlock Grid.Column="4" Text="Debt" Classes="eyebrow" />
                    <TextBlock Grid.Column="5" Text="Revenue" Classes="eyebrow" />
                    <TextBlock Grid.Column="6" Text="Expenses" Classes="eyebrow" />
                    <TextBlock Grid.Column="7" Text="Balance" Classes="eyebrow" />
                    <TextBlock Grid.Column="8" Text="Origin" Classes="eyebrow" />
                  </Grid>
                </Border>

                <ItemsControl Grid.Row="1" ItemsSource="{Binding View.Economy.History}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border
                          BorderBrush="#202B36"
                          BorderThickness="0,1,0,0"
                          Padding="12,9">
                        <Grid
                            ColumnDefinitions="100,105,150,95,110,110,110,110,*"
                            ColumnSpacing="8">
                          <StackPanel>
                            <TextBlock Text="{Binding Delivered}" />
                            <TextBlock
                                IsVisible="{Binding HasCaveats}"
                                Text="▲ contradiction"
                                FontSize="9"
                                Foreground="#D8A657" />
                          </StackPanel>
                          <TextBlock Grid.Column="1" Text="{Binding DataAge}" FontSize="11" Classes="muted" />
                          <TextBlock Grid.Column="2" Text="{Binding Source}" TextTrimming="CharacterEllipsis" />
                          <TextBlock Grid.Column="3" Text="{Binding Treasury}" FontWeight="SemiBold" Foreground="#8FD2A8" />
                          <TextBlock Grid.Column="4" Text="{Binding Debt}" />
                          <TextBlock Grid.Column="5" Text="{Binding Revenue}" />
                          <TextBlock Grid.Column="6" Text="{Binding Expenses}" />
                          <TextBlock Grid.Column="7" Text="{Binding Balance}" Foreground="#D8A657" />
                          <Border Grid.Column="8" Classes="badge" HorizontalAlignment="Left" Background="#171E27">
                            <TextBlock Text="{Binding Origin}" FontSize="10" Foreground="#AEBAC8" />
                          </Border>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </Grid>
            </Border>

            <Border Background="#14241C" BorderBrush="#376E4E" BorderThickness="1" CornerRadius="7" Padding="10">
              <TextBlock
                  Text="◆ A historical row is not corrected after the fact. If the Treasurer later revises the treasury from 800,000 to 620,000, both claims remain visible."
                  TextWrapping="Wrap"
                  Foreground="#A8D3B7"
                  FontSize="12" />
            </Border>
          </StackPanel>
        </ScrollViewer>

        <!-- Foreign Affairs -->
        <ScrollViewer IsVisible="{Binding IsForeignAffairsVisible}">
          <StackPanel Spacing="20">
            <StackPanel Spacing="5">
              <TextBlock Text="FOREIGN AFFAIRS" Classes="eyebrow" Foreground="#76B7E4" />
              <TextBlock Text="Diplomacy through imperfect information" Classes="title" />
              <TextBlock
                  Text="Treaties and declarations are public facts. Relations, intentions, economic scale and military strength are reported assessments."
                  TextWrapping="Wrap"
                  Classes="muted" />
            </StackPanel>

            <Border Classes="panel">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                <StackPanel Spacing="4">
                  <TextBlock Text="CHANCELLERY" Classes="eyebrow" Foreground="#76B7E4" />
                  <TextBlock
                      Text="{Binding View.ForeignAffairs.ChancellorName}"
                      FontSize="18"
                      FontWeight="SemiBold" />
                </StackPanel>
                <Border Grid.Column="1" Classes="badge" Background="#162433" VerticalAlignment="Top">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="Obedience" Classes="muted" FontSize="11" />
                    <TextBlock
                        Text="{Binding View.ForeignAffairs.ChancellorObedience}"
                        FontWeight="SemiBold"
                        FontSize="11"
                        Foreground="{Binding View.ForeignAffairs.ChancellorObedience, Converter={StaticResource SemanticStatusBrush}}" />
                  </StackPanel>
                </Border>
              </Grid>
            </Border>

            <Border Classes="card">
              <StackPanel Spacing="12">
                <TextBlock Text="COUNTRY DESK" Classes="eyebrow" Foreground="#76B7E4" />
                <Grid ColumnDefinitions="260,Auto" ColumnSpacing="8">
                  <ComboBox
                      ItemsSource="{Binding ForeignCountries}"
                      SelectedItem="{Binding SelectedForeignCountry}">
                    <ComboBox.ItemTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding Name}" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                  <Button
                      Grid.Column="1"
                      Classes="action intelligence"
                      Command="{Binding RequestForeignAffairsReportCommand}"
                      Content="Request fresh assessment" />
                </Grid>
              </StackPanel>
            </Border>

            <Border Classes="card" Padding="0">
              <Grid RowDefinitions="5,*">
                <Border Background="#5E9DD9" CornerRadius="8,8,0,0" />
                <StackPanel Grid.Row="1" Margin="16" Spacing="14">
                  <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Spacing="3">
                      <TextBlock
                          Text="{Binding SelectedForeignState.Name}"
                          FontSize="22"
                          FontWeight="SemiBold" />
                      <TextBlock
                          Text="{Binding SelectedForeignState.RulerName, StringFormat='Ruler: {0}'}"
                          Classes="muted" />
                      <TextBlock
                          Text="{Binding SelectedForeignState.Government}"
                          FontSize="11"
                          Foreground="#90A0B2" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" HorizontalAlignment="Right" Spacing="5">
                      <Border Classes="badge" Background="#162433">
                        <TextBlock
                            Text="{Binding SelectedForeignState.TradeStatus}"
                            Foreground="#8CBCE8"
                            FontSize="11" />
                      </Border>
                      <Border Classes="badge" Background="#211718">
                        <TextBlock
                            Text="{Binding SelectedForeignState.WarStatus}"
                            Foreground="#E99B9B"
                            FontSize="11" />
                      </Border>
                    </StackPanel>
                  </Grid>

                  <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                    <Border Background="#0D141C" CornerRadius="7" Padding="10">
                      <StackPanel Spacing="4">
                        <TextBlock Text="RELATIONS" Classes="eyebrow" Foreground="#76B7E4" />
                        <TextBlock Text="{Binding SelectedForeignState.Relations}" FontSize="16" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding SelectedForeignState.Trust, StringFormat='Trust {0}'}" FontSize="11" Classes="muted" />
                        <TextBlock Text="{Binding SelectedForeignState.Tension, StringFormat='Tension {0}'}" FontSize="11" Classes="muted" />
                      </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Background="#0D141C" CornerRadius="7" Padding="10">
                      <StackPanel Spacing="4">
                        <TextBlock Text="REPORTED GDP" Classes="eyebrow" Foreground="#75C493" />
                        <TextBlock Text="{Binding SelectedForeignState.Gdp}" FontSize="16" FontWeight="SemiBold" />
                      </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Background="#0D141C" CornerRadius="7" Padding="10">
                      <StackPanel Spacing="4">
                        <TextBlock Text="REPORTED ARMY" Classes="eyebrow" Foreground="#E28585" />
                        <TextBlock Text="{Binding SelectedForeignState.Army}" FontSize="16" FontWeight="SemiBold" />
                      </StackPanel>
                    </Border>
                  </Grid>

                  <WrapPanel Orientation="Horizontal">
                    <Button
                        Classes="action intelligence"
                        Margin="0,0,8,8"
                        Command="{Binding ImproveRelationsCommand}"
                        Content="◇  Improve relations" />
                    <Button
                        Classes="action economy"
                        Margin="0,0,8,8"
                        Command="{Binding ToggleTradeCommand}"
                        Content="{Binding TradeActionLabel}" />
                    <Button
                        Classes="action military"
                        Margin="0,0,8,8"
                        Command="{Binding RequestForeignMilitaryReportCommand}"
                        Content="⚑  Request military intelligence" />
                    <Button
                        Classes="action military"
                        Margin="0,0,8,8"
                        IsVisible="{Binding SelectedForeignState.CanDeclareWar}"
                        Command="{Binding DeclareWarCommand}"
                        Content="⚠  Declare war" />
                  </WrapPanel>
                </StackPanel>
              </Grid>
            </Border>

            <StackPanel Spacing="8">
              <TextBlock Text="INCOMING PROPOSALS" Classes="eyebrow" />
              <ItemsControl ItemsSource="{Binding View.ForeignAffairs.IncomingProposals}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Classes="card" Margin="0,0,0,9">
                      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                        <StackPanel Spacing="4">
                          <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock
                                Text="{Binding SourceCountry}"
                                FontSize="16"
                                FontWeight="SemiBold" />
                            <Border Classes="badge" Background="#162433">
                              <TextBlock Text="{Binding Type}" FontSize="10" Foreground="#8CBCE8" />
                            </Border>
                          </StackPanel>
                          <TextBlock Text="{Binding Terms}" Foreground="#CBD5DF" />
                          <TextBlock Text="{Binding Age}" FontSize="11" Classes="muted" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                          <Button
                              Classes="action economy"
                              Command="{Binding #Root.DataContext.AcceptProposalCommand}"
                              CommandParameter="{Binding}"
                              Content="Accept" />
                          <Button
                              Classes="action"
                              Command="{Binding #Root.DataContext.RejectProposalCommand}"
                              CommandParameter="{Binding}"
                              Content="Reject" />
                        </StackPanel>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>

        <!-- Military -->
        <ScrollViewer IsVisible="{Binding IsMilitaryVisible}">
          <StackPanel Spacing="20">
            <StackPanel Spacing="5">
              <TextBlock Text="MILITARY" Classes="eyebrow" Foreground="#E28585" />
              <TextBlock Text="Command through reports, not omniscience" Classes="title" />
              <TextBlock
                  Text="You can issue campaign directives, but army strength, readiness and battlefield position remain reported estimates."
                  TextWrapping="Wrap"
                  Classes="muted" />
            </StackPanel>

            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
              <Border Classes="card" Padding="0">
                <Grid RowDefinitions="5,*">
                  <Border Background="#D96C6C" CornerRadius="8,8,0,0" />
                  <StackPanel Grid.Row="1" Margin="14" Spacing="5">
                    <TextBlock Text="OUR ARMY" Classes="eyebrow" Foreground="#E28585" />
                    <TextBlock
                        Text="{Binding View.Military.ArmyStrength}"
                        FontSize="20"
                        FontWeight="SemiBold" />
                  </StackPanel>
                </Grid>
              </Border>

              <Border Grid.Column="1" Classes="card" Padding="0">
                <Grid RowDefinitions="5,*">
                  <Border Background="#D8A657" CornerRadius="8,8,0,0" />
                  <StackPanel Grid.Row="1" Margin="14" Spacing="5">
                    <TextBlock Text="READINESS" Classes="eyebrow" Foreground="#E1B66F" />
                    <TextBlock
                        Text="{Binding View.Military.ArmyReadiness}"
                        FontSize="20"
                        FontWeight="SemiBold" />
                  </StackPanel>
                </Grid>
              </Border>

              <Border Grid.Column="2" Classes="card" Padding="0">
                <Grid RowDefinitions="5,*">
                  <Border Background="#A77BD7" CornerRadius="8,8,0,0" />
                  <StackPanel Grid.Row="1" Margin="14" Spacing="5">
                    <TextBlock Text="WAR EXHAUSTION" Classes="eyebrow" Foreground="#C096E2" />
                    <TextBlock
                        Text="{Binding View.Military.WarExhaustion}"
                        FontSize="20"
                        FontWeight="SemiBold" />
                  </StackPanel>
                </Grid>
              </Border>
            </Grid>

            <Border Classes="panel">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                <StackPanel Spacing="4">
                  <TextBlock Text="HIGH COMMAND" Classes="eyebrow" Foreground="#E28585" />
                  <TextBlock
                      Text="{Binding View.Military.MarshalName}"
                      FontSize="18"
                      FontWeight="SemiBold" />
                </StackPanel>
                <Border Grid.Column="1" Classes="badge" Background="#211718" VerticalAlignment="Top">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="Obedience" Classes="muted" FontSize="11" />
                    <TextBlock
                        Text="{Binding View.Military.MarshalObedience}"
                        FontWeight="SemiBold"
                        FontSize="11"
                        Foreground="{Binding View.Military.MarshalObedience, Converter={StaticResource SemanticStatusBrush}}" />
                  </StackPanel>
                </Border>
              </Grid>
            </Border>

            <Border Classes="card">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <StackPanel>
                  <TextBlock Text="CAMPAIGNS" Classes="eyebrow" Foreground="#E28585" />
                  <TextBlock
                      Text="{Binding View.Military.Campaigns.Count, StringFormat='{}{0} active campaign(s)'}"
                      FontSize="16"
                      FontWeight="SemiBold" />
                </StackPanel>
                <Button
                    Grid.Column="1"
                    Classes="action military"
                    Command="{Binding RequestOwnMilitaryReportCommand}"
                    Content="⚑  Request own-army report" />
              </Grid>
            </Border>

            <StackPanel IsVisible="{Binding HasActiveCampaigns}" Spacing="12">
              <ComboBox
                  ItemsSource="{Binding View.Military.Campaigns}"
                  SelectedItem="{Binding SelectedCampaign}"
                  HorizontalAlignment="Stretch">
                <ComboBox.ItemTemplate>
                  <DataTemplate>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                      <TextBlock Text="{Binding OpponentName}" FontWeight="SemiBold" />
                      <TextBlock Grid.Column="1" Text="{Binding MonthsActive}" Classes="muted" />
                    </Grid>
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>

              <Border Classes="card" Padding="0">
                <Grid RowDefinitions="5,*">
                  <Border Background="#D96C6C" CornerRadius="8,8,0,0" />
                  <StackPanel Grid.Row="1" Margin="16" Spacing="14">
                    <Grid ColumnDefinitions="*,Auto">
                      <StackPanel>
                        <TextBlock
                            Text="{Binding SelectedCampaign.OpponentName, StringFormat='Campaign against {0}'}"
                            FontSize="20"
                            FontWeight="SemiBold" />
                        <TextBlock
                            Text="{Binding SelectedCampaign.MonthsActive}"
                            Classes="muted" />
                      </StackPanel>
                      <Border Grid.Column="1" Classes="badge" Background="#211718">
                        <TextBlock
                            Text="{Binding SelectedCampaign.Stance, StringFormat='Stance: {0}'}"
                            Foreground="#E99B9B"
                            FontSize="11" />
                      </Border>
                    </Grid>

                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                      <Border Background="#0D141C" CornerRadius="7" Padding="10">
                        <StackPanel Spacing="4">
                          <TextBlock Text="CAMPAIGN POSITION" Classes="eyebrow" Foreground="#E1B66F" />
                          <TextBlock
                              Text="{Binding SelectedCampaign.CampaignPosition}"
                              FontSize="16"
                              FontWeight="SemiBold" />
                        </StackPanel>
                      </Border>

                      <Border Grid.Column="1" Background="#0D141C" CornerRadius="7" Padding="10">
                        <StackPanel Spacing="4">
                          <TextBlock Text="OUR FORCE" Classes="eyebrow" Foreground="#8CBCE8" />
                          <TextBlock Text="{Binding SelectedCampaign.OwnArmy}" FontWeight="SemiBold" />
                          <TextBlock Text="{Binding SelectedCampaign.OwnReadiness, StringFormat='Readiness {0}'}"
                                     FontSize="11" Classes="muted" />
                        </StackPanel>
                      </Border>

                      <Border Grid.Column="2" Background="#0D141C" CornerRadius="7" Padding="10">
                        <StackPanel Spacing="4">
                          <TextBlock Text="ENEMY ESTIMATE" Classes="eyebrow" Foreground="#E28585" />
                          <TextBlock Text="{Binding SelectedCampaign.EnemyArmy}" FontWeight="SemiBold" />
                          <TextBlock Text="{Binding SelectedCampaign.EnemyReadiness, StringFormat='Readiness {0}'}"
                                     FontSize="11" Classes="muted" />
                        </StackPanel>
                      </Border>
                    </Grid>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                      <Border Classes="panel" Background="#111821">
                        <StackPanel Spacing="10">
                          <TextBlock Text="CAMPAIGN DIRECTIVE" Classes="eyebrow" Foreground="#E28585" />
                          <ComboBox
                              ItemsSource="{Binding WarStanceOptions}"
                              SelectedItem="{Binding SelectedWarStance}" />
                          <Button
                              Classes="action military"
                              HorizontalAlignment="Left"
                              Command="{Binding ApplyWarStanceCommand}"
                              Content="Issue stance order" />
                          <TextBlock
                              Text="A reluctant Marshal may refuse or moderate an extreme order."
                              TextWrapping="Wrap"
                              FontSize="11"
                              Classes="muted" />
                        </StackPanel>
                      </Border>

                      <Border Grid.Column="1" Classes="panel" Background="#111821">
                        <StackPanel Spacing="10">
                          <TextBlock Text="PEACE CHANNEL" Classes="eyebrow" Foreground="#76B7E4" />
                          <ComboBox
                              ItemsSource="{Binding PeaceTermOptions}"
                              SelectedItem="{Binding SelectedPeaceTerms}" />
                          <Button
                              Classes="action intelligence"
                              HorizontalAlignment="Left"
                              Command="{Binding OfferPeaceCommand}"
                              Content="Send peace proposal" />
                          <TextBlock
                              Text="Foreign acceptance is not shown as a percentage. Your Chancellor must actually test the proposal."
                              TextWrapping="Wrap"
                              FontSize="11"
                              Classes="muted" />
                        </StackPanel>
                      </Border>
                    </Grid>

                    <WrapPanel Orientation="Horizontal">
                      <Button
                          Classes="action military"
                          Margin="0,0,8,0"
                          Command="{Binding RequestCampaignIntelligenceCommand}"
                          Content="⚑  Request fresh enemy intelligence" />
                    </WrapPanel>
                  </StackPanel>
                </Grid>
              </Border>
            </StackPanel>

            <Border
                IsVisible="{Binding HasActiveCampaigns}"
                Background="#2A2115"
                BorderBrush="#6D542D"
                BorderThickness="1"
                CornerRadius="7"
                Padding="10">
              <TextBlock
                  Text="▲ Battlefield information can lag the real war. A sudden reinforcement, collapse or defeat may not appear until the Marshal's reports catch up."
                  TextWrapping="Wrap"
                  Foreground="#E0C28D"
                  FontSize="12" />
            </Border>
          </StackPanel>
        </ScrollViewer>

        <!-- Intelligence -->
        <ScrollViewer IsVisible="{Binding IsIntelligenceVisible}">
          <StackPanel Spacing="20">
            <StackPanel Spacing="4">
              <TextBlock Text="INTELLIGENCE" Classes="eyebrow" Foreground="#70C4D0" />
              <TextBlock
                  Text="Reports and inquiries"
                  Classes="title" />
              <TextBlock
                  Text="Task advisers for information, compare their claims and keep track of how old your picture of the world has become."
                  TextWrapping="Wrap"
                  Classes="muted" />
            </StackPanel>

            <Border Classes="card">
              <StackPanel Spacing="12">
                <TextBlock Text="REQUEST A REPORT" Classes="eyebrow" />
                <WrapPanel Orientation="Horizontal">
                  <Button
                      Margin="0,0,8,8"
                      Classes="action economy"
                      Command="{Binding RequestEconomyReportCommand}"
                      Content="▥  Treasurer · Economy" />
                  <Button
                      Margin="0,0,8,8"
                      Classes="action military"
                      Command="{Binding RequestOwnMilitaryReportCommand}"
                      Content="⚑  Marshal · Our military" />
                  <Button
                      Margin="0,0,8,8"
                      Classes="action politics"
                      Command="{Binding RequestDomesticReportCommand}"
                      Content="♟  Chancellor · Domestic politics" />
                </WrapPanel>

                <Grid ColumnDefinitions="220,Auto,Auto" ColumnSpacing="8">
                  <ComboBox
                      ItemsSource="{Binding ForeignCountries}"
                      SelectedItem="{Binding SelectedForeignCountry}"
                      PlaceholderText="Choose foreign country">
                    <ComboBox.ItemTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding Name}" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                  <Button
                      Grid.Column="1"
                      Classes="action intelligence"
                      Command="{Binding RequestForeignAffairsReportCommand}"
                      Content="◇  Chancellor assessment" />
                  <Button
                      Grid.Column="2"
                      Classes="action military"
                      Command="{Binding RequestForeignMilitaryReportCommand}"
                      Content="⚑  Marshal intelligence" />
                </Grid>
              </StackPanel>
            </Border>

            <StackPanel IsVisible="{Binding HasPendingReports}">
              <TextBlock Text="PENDING INQUIRIES" Classes="eyebrow" />
              <ItemsControl ItemsSource="{Binding View.PendingInquiries}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Classes="card" Margin="0,8,0,0" Padding="0">
                      <Grid ColumnDefinitions="5,*,Auto">
                        <Border Background="#55B8C7" CornerRadius="8,0,0,8" />
                        <StackPanel Grid.Column="1" Margin="12" Spacing="3">
                          <StackPanel Orientation="Horizontal" Spacing="7">
                            <TextBlock
                                Text="{Binding Topic}"
                                FontWeight="SemiBold" />
                            <Border Classes="badge" Background="#153038" Padding="7,2">
                              <TextBlock Text="UNDERWAY" FontSize="9" FontWeight="Bold" Foreground="#79CFDB" />
                            </Border>
                          </StackPanel>
                          <TextBlock
                              Text="{Binding Advisor}"
                              FontSize="12"
                              Classes="muted" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" HorizontalAlignment="Right" Margin="12">
                          <TextBlock Text="{Binding Subject}" HorizontalAlignment="Right" />
                          <TextBlock
                              Text="{Binding Since, StringFormat='Queued {0}'}"
                              FontSize="11"
                              Classes="muted"
                              HorizontalAlignment="Right" />
                        </StackPanel>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>

            <StackPanel Spacing="8">
              <TextBlock Text="REPORT HISTORY" Classes="eyebrow" />
              <ItemsControl ItemsSource="{Binding View.IntelligenceReports}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Classes="card" Margin="0,0,0,10" Padding="0">
                      <Grid ColumnDefinitions="5,*">
                        <Border
                            Background="{Binding Source, Converter={StaticResource AdvisorRoleBrush}}"
                            CornerRadius="8,0,0,8" />
                        <StackPanel Grid.Column="1" Spacing="9" Margin="14">
                          <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="4">
                              <TextBlock
                                  Text="{Binding Title}"
                                  FontSize="17"
                                  FontWeight="SemiBold"
                                  TextWrapping="Wrap" />
                              <StackPanel Orientation="Horizontal" Spacing="7">
                                <Border
                                    Classes="badge"
                                    Background="{Binding Source, Converter={StaticResource AdvisorRoleBrush}}">
                                  <TextBlock
                                      Text="{Binding Source}"
                                      FontSize="10"
                                      FontWeight="Bold"
                                      Foreground="#081016" />
                                </Border>
                                <TextBlock
                                    Text="{Binding DataAge}"
                                    FontSize="11"
                                    Classes="muted"
                                    VerticalAlignment="Center" />
                              </StackPanel>
                            </StackPanel>
                            <Border
                                Grid.Column="1"
                                Classes="badge"
                                Background="#1A2430"
                                VerticalAlignment="Top">
                              <TextBlock
                                  Text="{Binding Origin}"
                                  FontSize="10"
                                  Foreground="#B9C5D3" />
                            </Border>
                          </Grid>

                          <TextBlock
                              Text="{Binding Summary}"
                              TextWrapping="Wrap"
                              Foreground="#C4CED9" />

                          <Border Background="#0D141C" CornerRadius="7" Padding="10">
                            <ItemsControl ItemsSource="{Binding Facts}">
                              <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                  <Grid
                                      ColumnDefinitions="190,110,90,*"
                                      Margin="0,4">
                                    <TextBlock Text="{Binding Label}" Foreground="#D8E0E8" />
                                    <TextBlock
                                        Grid.Column="1"
                                        Text="{Binding Value}"
                                        FontWeight="SemiBold"
                                        Foreground="#F1F5F9" />
                                    <TextBlock
                                        Grid.Column="2"
                                        Text="{Binding Margin}"
                                        Foreground="#D8A657" />
                                    <TextBlock
                                        Grid.Column="3"
                                        Text="{Binding Confidence}"
                                        FontSize="11"
                                        Classes="muted" />
                                  </Grid>
                                </DataTemplate>
                              </ItemsControl.ItemTemplate>
                            </ItemsControl>
                          </Border>

                          <ItemsControl ItemsSource="{Binding Caveats}">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate>
                                <Border
                                    Background="#2A2115"
                                    BorderBrush="#6D542D"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="9,7"
                                    Margin="0,2">
                                  <StackPanel Orientation="Horizontal" Spacing="7">
                                    <TextBlock
                                        Text="▲"
                                        Foreground="#E3B76C"
                                        FontWeight="Bold" />
                                    <TextBlock
                                        Text="{Binding}"
                                        TextWrapping="Wrap"
                                        Foreground="#E0C28D"
                                        FontSize="12" />
                                  </StackPanel>
                                </Border>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </StackPanel>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>

        <!-- Archive -->
        <ScrollViewer IsVisible="{Binding IsArchiveVisible}">
          <StackPanel Spacing="20">
            <StackPanel Spacing="5">
              <TextBlock Text="ARCHIVE" Classes="eyebrow" Foreground="#AAB5C2" />
              <TextBlock Text="What the government knew, ordered and believed" Classes="title" />
              <TextBlock
                  Text="Old reports are preserved as they were received. The archive records past beliefs instead of rewriting them to match later truth."
                  TextWrapping="Wrap"
                  Classes="muted" />
            </StackPanel>

            <Border Classes="panel">
              <Grid ColumnDefinitions="*,220,Auto" ColumnSpacing="9">
                <TextBox
                    Watermark="Search reports, people, countries or dates…"
                    Text="{Binding ArchiveSearchText, Mode=TwoWay}" />
                <ComboBox
                    Grid.Column="1"
                    ItemsSource="{Binding ArchiveCategoryOptions}"
                    SelectedItem="{Binding SelectedArchiveCategory}" />
                <Border Grid.Column="2" Classes="badge" Background="#1A2430" VerticalAlignment="Center">
                  <TextBlock
                      Text="{Binding ArchiveEntries.Count, StringFormat='{}{0} matching entries'}"
                      FontSize="11"
                      Foreground="#B9C5D3" />
                </Border>
              </Grid>
            </Border>

            <ItemsControl ItemsSource="{Binding ArchiveEntries}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border
                      Classes="card"
                      Margin="0,0,0,10"
                      Background="{Binding NeedsAttention, Converter={StaticResource AttentionBackground}}">
                    <Grid ColumnDefinitions="5,*" ColumnSpacing="12">
                      <Border
                          Background="{Binding Category, Converter={StaticResource CategoryBrush}}"
                          CornerRadius="4" />
                      <StackPanel Grid.Column="1" Spacing="7">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                          <Border
                              Classes="badge"
                              Background="{Binding Category, Converter={StaticResource CategoryBrush}}">
                            <TextBlock
                                Text="{Binding Category}"
                                FontSize="10"
                                FontWeight="Bold"
                                Foreground="#081016" />
                          </Border>
                          <TextBlock
                              Grid.Column="1"
                              Text="{Binding Source}"
                              Margin="9,0,0,0"
                              VerticalAlignment="Center"
                              FontSize="11"
                              Classes="muted" />
                          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="7">
                            <Border
                                Classes="badge"
                                Background="#2A2115"
                                IsVisible="{Binding NeedsAttention}">
                              <TextBlock
                                  Text="▲ ATTENTION"
                                  FontSize="9"
                                  FontWeight="Bold"
                                  Foreground="#E3B76C" />
                            </Border>
                            <Border Classes="badge" Background="#171E27">
                              <TextBlock
                                  Text="{Binding Date}"
                                  FontSize="10"
                                  Foreground="#AEBAC8" />
                            </Border>
                          </StackPanel>
                        </Grid>

                        <TextBlock
                            Text="{Binding Title}"
                            FontSize="17"
                            FontWeight="SemiBold"
                            TextWrapping="Wrap" />
                        <TextBlock
                            Text="{Binding Details}"
                            TextWrapping="Wrap"
                            Foreground="#C4CED9" />
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border Background="#141B23" BorderBrush="#33404E" BorderThickness="1" CornerRadius="7" Padding="10">
              <TextBlock
                  Text="▤ Archive entries are player-visible records. Hidden simulation truth and private AI calculations are never stored here for the UI to discover."
                  TextWrapping="Wrap"
                  Foreground="#AEBAC8"
                  FontSize="12" />
            </Border>
          </StackPanel>
        </ScrollViewer>

        <!-- Placeholder surfaces -->
        <Grid IsVisible="{Binding IsPlaceholderVisible}">
          <Border
              Classes="card"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Top"
              Padding="24">
            <StackPanel Spacing="9">
              <TextBlock
                  Text="{Binding SectionTitle}"
                  Classes="title" />
              <TextBlock
                  Text="{Binding SectionDescription}"
                  FontSize="15"
                  TextWrapping="Wrap"
                  Foreground="#C4CED9"
                  MaxWidth="720" />
              <TextBlock
                  Margin="0,12,0,0"
                  Text="This navigation surface is intentionally present now so each simulation system can migrate behind the same player-information boundary rather than growing as a separate UI."
                  TextWrapping="Wrap"
                  Classes="muted"
                  MaxWidth="720" />
            </StackPanel>
          </Border>
        </Grid>
      </Grid>

      <Border
          Grid.Column="2"
          Background="#0D131A"
          BorderBrush="#26313D"
          BorderThickness="1,0,0,0"
          Padding="18,22">
        <ScrollViewer>
          <StackPanel Spacing="14">
            <StackPanel Spacing="3">
              <TextBlock Text="ADVISERS" Classes="eyebrow" />
              <TextBlock
                  Text="People between you and the state"
                  FontSize="17"
                  FontWeight="SemiBold"
                  TextWrapping="Wrap" />
            </StackPanel>

            <ItemsControl ItemsSource="{Binding View.Advisors}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Classes="card" Margin="0,0,0,10">
                    <StackPanel Spacing="6">
                      <TextBlock
                          Text="{Binding Office}"
                          Classes="eyebrow" />
                      <TextBlock
                          Text="{Binding Name}"
                          FontSize="16"
                          FontWeight="SemiBold" />
                      <Grid
                          ColumnDefinitions="Auto,*"
                          RowDefinitions="Auto,Auto,Auto,Auto"
                          ColumnSpacing="12"
                          RowSpacing="5">
                        <TextBlock Text="Ability" Classes="muted" />
                        <TextBlock
                            Grid.Column="1"
                            Text="{Binding Ability}"
                            FontWeight="SemiBold"
                            Foreground="{Binding Ability, Converter={StaticResource SemanticStatusBrush}}" />

                        <TextBlock Grid.Row="1" Text="Trust" Classes="muted" />
                        <TextBlock
                            Grid.Row="1"
                            Grid.Column="1"
                            Text="{Binding Trust}"
                            FontWeight="SemiBold"
                            Foreground="{Binding Trust, Converter={StaticResource SemanticStatusBrush}}" />

                        <TextBlock Grid.Row="2" Text="Obedience" Classes="muted" />
                        <TextBlock
                            Grid.Row="2"
                            Grid.Column="1"
                            Text="{Binding Obedience}"
                            FontWeight="SemiBold"
                            Foreground="{Binding Obedience, Converter={StaticResource SemanticStatusBrush}}" />

                        <TextBlock Grid.Row="3" Text="Risk" Classes="muted" />
                        <Border
                            Grid.Row="3"
                            Grid.Column="1"
                            Classes="badge"
                            HorizontalAlignment="Left"
                            Background="#171E27"
                            Padding="7,2">
                          <TextBlock
                              Text="{Binding Risk}"
                              FontWeight="Bold"
                              FontSize="11"
                              Foreground="{Binding Risk, Converter={StaticResource RiskBrush}}" />
                        </Border>
                      </Grid>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border Classes="card">
              <StackPanel Spacing="5">
                <TextBlock Text="INFORMATION RULE" Classes="eyebrow" />
                <TextBlock
                    Text="The desktop UI does not bind to hidden simulation values."
                    TextWrapping="Wrap"
                    FontWeight="SemiBold" />
                <TextBlock
                    Text="Numbers shown as estimates come from the ruler's current knowledge state. Advisers may be wrong."
                    TextWrapping="Wrap"
                    FontSize="12"
                    Classes="muted" />
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>

    <Grid
        Grid.RowSpan="2"
        IsVisible="{Binding IsCampaignSetupVisible}"
        Background="#0A1017">
      <ScrollViewer>
        <StackPanel
            MaxWidth="1080"
            Margin="48"
            HorizontalAlignment="Center"
            Spacing="24">
          <StackPanel Spacing="7">
            <TextBlock
                Text="LEADER GAME"
                Classes="eyebrow"
                Foreground="#70C4D0" />
            <TextBlock
                Text="Choose who you are before history starts moving"
                FontSize="34"
                FontWeight="SemiBold"
                TextWrapping="Wrap" />
            <TextBlock
                MaxWidth="820"
                Text="The world is shared, but your political lineage, advisers, pressures and victory conditions depend on where you begin."
                FontSize="15"
                TextWrapping="Wrap"
                Foreground="#AEBAC8" />
          </StackPanel>

          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button
                Classes="primary"
                Command="{Binding LoadCommand}"
                Content="↺  Continue manual save" />
            <Button
                Classes="action"
                Command="{Binding RecoverAutosaveCommand}"
                Content="⟲  Recover autosave" />
          </StackPanel>

          <TextBlock Text="NEW CAMPAIGN" Classes="eyebrow" />

          <ItemsControl ItemsSource="{Binding ScenarioOptions}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel Orientation="Horizontal" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border
                    Classes="card"
                    Width="490"
                    MinHeight="330"
                    Margin="0,0,14,14"
                    Padding="0">
                  <Grid RowDefinitions="6,*">
                    <Border
                        Background="#55B8C7"
                        CornerRadius="8,8,0,0" />
                    <StackPanel Grid.Row="1" Margin="20" Spacing="12">
                      <StackPanel Spacing="4">
                        <TextBlock
                            Text="{Binding Name}"
                            FontSize="24"
                            FontWeight="SemiBold" />
                        <TextBlock
                            Text="{Binding Country}"
                            Foreground="#86CBD6"
                            FontWeight="SemiBold" />
                      </StackPanel>

                      <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                        <Border Background="#0D141C" CornerRadius="6" Padding="9">
                          <StackPanel Spacing="3">
                            <TextBlock Text="LEADER" Classes="eyebrow" />
                            <TextBlock Text="{Binding Leader}" FontWeight="SemiBold" />
                          </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Background="#0D141C" CornerRadius="6" Padding="9">
                          <StackPanel Spacing="3">
                            <TextBlock Text="LINEAGE" Classes="eyebrow" />
                            <TextBlock Text="{Binding Lineage}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding GovernmentStyle}" FontSize="10" Classes="muted" />
                          </StackPanel>
                        </Border>
                      </Grid>

                      <TextBlock
                          Text="{Binding Summary}"
                          TextWrapping="Wrap"
                          Foreground="#C8D2DD" />

                      <Border Background="#211C14" BorderBrush="#5F4A28" BorderThickness="1" CornerRadius="6" Padding="10">
                        <StackPanel Spacing="3">
                          <TextBlock Text="OPENING PROBLEM" Classes="eyebrow" Foreground="#D8A657" />
                          <TextBlock
                              Text="{Binding StrategicProblem}"
                              TextWrapping="Wrap"
                              FontSize="12"
                              Foreground="#DFC697" />
                        </StackPanel>
                      </Border>

                      <Button
                          Classes="primary"
                          HorizontalAlignment="Left"
                          Command="{Binding #Root.DataContext.StartScenarioCommand}"
                          CommandParameter="{Binding}"
                          Content="Begin campaign  →" />
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </Grid>
</Window>

<Application
    x:Class="LeaderGame.Desktop.App"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedThemeVariant="Dark">

  <Application.Styles>
    <FluentTheme />

    <Style Selector="Window">
      <Setter Property="Background" Value="#0B0F14" />
      <Setter Property="FontFamily" Value="Segoe UI" />
    </Style>

    <Style Selector="Border.card">
      <Setter Property="Background" Value="#121922" />
      <Setter Property="BorderBrush" Value="#27313D" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="14" />
    </Style>

    <Style Selector="Border.card.attention">
      <Setter Property="BorderBrush" Value="#9B7545" />
      <Setter Property="Background" Value="#1A1712" />
    </Style>

    <Style Selector="Button.nav">
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Padding" Value="12,9" />
      <Setter Property="Margin" Value="0,2" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="#CFD7E3" />
    </Style>

    <Style Selector="Button.nav:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#18212C" />
    </Style>

    <Style Selector="Button.primary">
      <Setter Property="Padding" Value="16,9" />
      <Setter Property="Background" Value="#D8E2EF" />
      <Setter Property="Foreground" Value="#0B0F14" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style Selector="TextBlock.muted">
      <Setter Property="Foreground" Value="#8996A6" />
    </Style>

    <Style Selector="TextBlock.eyebrow">
      <Setter Property="Foreground" Value="#9EACBC" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="LetterSpacing" Value="1.1" />
    </Style>

    <Style Selector="TextBlock.title">
      <Setter Property="FontSize" Value="25" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="#EDF2F7" />
    </Style>
  </Application.Styles>
</Application>
